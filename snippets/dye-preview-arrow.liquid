{%- doc -%}
  Thin long arrow used by the Dye color preview section.

  @param {string} direction - 'left' or 'right'
{%- enddoc -%}
<svg viewBox="0 0 42 12" fill="none" aria-hidden="true">
  {%- if direction == 'left' -%}
