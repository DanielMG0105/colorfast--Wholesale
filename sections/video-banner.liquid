{%- liquid
  assign video = section.settings.video
  assign video_mobile = section.settings.video_mobile | default: video

  assign poster_desktop = nil
  assign poster_mobile = nil
  if section.settings.show_poster
    assign poster_source = section.settings.poster_image | default: video.preview_image
    if poster_source != blank
      assign poster_desktop = poster_source | image_url: width: 2400
    endif
    assign poster_source_mobile = section.settings.poster_image_mobile | default: section.settings.poster_image | default: video_mobile.preview_image
    if poster_source_mobile != blank
      assign poster_mobile = poster_source_mobile | image_url: width: 1200
    endif
  endif

  assign ratio = 3.5
  if video != blank and video.aspect_ratio
    assign ratio = video.aspect_ratio
  endif
  assign ratio_mobile = ratio
  if video_mobile != blank and video_mobile.aspect_ratio
    assign ratio_mobile = video_mobile.aspect_ratio
  endif

  assign overlay_font = section.settings.overlay_font
  assign overlay_logo = section.settings.overlay_logo
  if overlay_logo == blank and section.settings.overlay_use_store_logo
    assign overlay_logo = settings.logo
  endif
  assign show_overlay = false
  if overlay_logo != blank or section.settings.overlay_text != blank
    assign show_overlay = true
  endif

  if section.settings.height_mode == 'custom_ratio'
    assign ratio = section.settings.custom_ratio
    assign ratio_mobile = section.settings.custom_ratio_mobile
  endif
-%}

{%- if show_overlay and section.settings.overlay_text != blank -%}
  <style>
    {{ overlay_font | font_face: font_display: 'swap' }}
  </style>
{%- endif -%}

<div
  class="video-banner video-banner--{% if section.settings.height_mode == 'custom' %}custom{% else %}ratio{% endif %}"
  data-footer-bg="ignore"
  style="
    --vb-ratio: {{ ratio }};
    --vb-ratio-mobile: {{ ratio_mobile }};
    --vb-height: {{ section.settings.height }}px;
    --vb-height-mobile: {{ section.settings.height_mobile }}px;
    --vb-position: {{ section.settings.video_position }};
    --vb-bg: {{ section.settings.background_color }};
    --vb-overlay-color: {{ section.settings.overlay_color }};
    --vb-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --vb-logo-width: {{ section.settings.overlay_logo_width }}%;
    --vb-text-size: {{ section.settings.overlay_text_size }}px;
    --vb-text-size-n: {{ section.settings.overlay_text_size }};
    --vb-u: min(1px, calc(100vw / 1900));
    --vb-text-spacing: {{ section.settings.overlay_letter_spacing | divided_by: 100.0 }}em;
    --vb-text-color: {{ section.settings.overlay_text_color }};
    --vb-font-family: {{ overlay_font.family }}, {{ overlay_font.fallback_families }};
    --vb-font-weight: {{ overlay_font.weight }};
  "
>
  {%- if video != blank -%}
    <div class="video-banner__media{% if video_mobile != video %} video-banner__media--desktop{% endif %}">
      {{
        video
        | video_tag:
          poster: poster_desktop,
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata',
          class: 'video-banner__video'
      }}
    </div>
    {%- if video_mobile != video -%}
      <div class="video-banner__media video-banner__media--mobile">
        {{
          video_mobile
          | video_tag:
            poster: poster_mobile,
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            class: 'video-banner__video'
        }}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="video-banner__media">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'video-banner__placeholder' }}
    </div>
  {%- endif -%}

  {%- if show_overlay -%}
    <div class="video-banner__overlay">
      {%- if overlay_logo != blank -%}
        {%- capture logo_class -%}video-banner__logo{% if section.settings.overlay_logo_white %} video-banner__logo--white{% endif %}{%- endcapture -%}
        {{
          overlay_logo
          | image_url: width: 1200
          | image_tag:
            widths: '300, 600, 900, 1200',
            sizes: '(min-width: 750px) 30vw, 50vw',
            loading: 'lazy',
            alt: shop.name,
            class: logo_class
        }}
      {%- endif -%}
      {%- if section.settings.overlay_text != blank -%}
        <p class="video-banner__text">{{ section.settings.overlay_text | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.link != blank -%}
    <a class="video-banner__link" href="{{ section.settings.link }}">
      <span class="visually-hidden">{{ section.settings.link_label | default: 'View more' | escape }}</span>
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .video-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--vb-bg);
  }

  .video-banner--ratio {
    aspect-ratio: var(--vb-ratio-mobile);

    @media screen and (min-width: 750px) {
      aspect-ratio: var(--vb-ratio);
    }
  }

  .video-banner--custom {
    height: var(--vb-height-mobile);

    @media screen and (min-width: 750px) {
      height: var(--vb-height);
    }
  }

  .video-banner__media {
    position: absolute;
    inset: 0;
  }

  .video-banner__media--desktop {
    display: none;

    @media screen and (min-width: 750px) {
      display: block;
    }
  }

  .video-banner__media--mobile {
    display: block;

    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  .video-banner__video,
  .video-banner__media video,
  .video-banner__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--vb-position);
  }

  .video-banner__placeholder {
    opacity: 0.3;
  }

  .video-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9em;
    padding: 16px;
    text-align: center;
    pointer-events: none;
    color: var(--vb-text-color);
    font-size: max(9px, calc(var(--vb-text-size) * 0.6));

    @media screen and (min-width: 750px) {
      font-size: max(10px, calc(var(--vb-text-size-n) * var(--vb-u)));
    }
  }

  .video-banner__overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--vb-overlay-color);
    opacity: var(--vb-overlay-opacity);
  }

  .video-banner__logo {
    display: block;
    width: calc(var(--vb-logo-width) * 1.6);
    max-width: 80%;
    height: auto;

    @media screen and (min-width: 750px) {
      width: var(--vb-logo-width);
    }
  }

  .video-banner__logo--white {
    filter: brightness(0) invert(1);
  }

  .video-banner__text {
    margin: 0;
    font-family: var(--vb-font-family);
    font-weight: var(--vb-font-weight);
    letter-spacing: var(--vb-text-spacing);
    line-height: 1.2;
    text-transform: uppercase;
  }

  .video-banner__link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video banner",
  "tag": "section",
  "class": "section-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays muted, looped and autoplayed."
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video (optional)"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "Video position",
      "info": "Which part of the video stays visible when it is cropped.",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Height mode",
      "options": [
        { "value": "ratio", "label": "Video aspect ratio" },
        { "value": "custom_ratio", "label": "Custom aspect ratio" },
        { "value": "custom", "label": "Custom height" }
      ],
      "default": "ratio"
    },
    {
      "type": "range",
      "id": "custom_ratio",
      "label": "Desktop aspect ratio (width / height)",
      "info": "E.g. 6.8 = a wide strip, 1.8 = 16:9. The video is cropped to fit.",
      "min": 1,
      "max": 10,
      "step": 0.1,
      "default": 6.8,
      "visible_if": "{{ section.settings.height_mode == 'custom_ratio' }}"
    },
    {
      "type": "range",
      "id": "custom_ratio_mobile",
      "label": "Mobile aspect ratio (width / height)",
      "min": 1,
      "max": 10,
      "step": 0.1,
      "default": 3,
      "visible_if": "{{ section.settings.height_mode == 'custom_ratio' }}"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 150,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 350,
      "visible_if": "{{ section.settings.height_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 200,
      "visible_if": "{{ section.settings.height_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Poster"
    },
    {
      "type": "checkbox",
      "id": "show_poster",
      "label": "Show poster",
      "info": "Image displayed while the video loads. Uses the video's preview image unless a custom one is set.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Custom poster (optional)",
      "visible_if": "{{ section.settings.show_poster }}"
    },
    {
      "type": "image_picker",
      "id": "poster_image_mobile",
      "label": "Custom mobile poster (optional)",
      "visible_if": "{{ section.settings.show_poster }}"
    },
    {
      "type": "header",
      "content": "Text overlay"
    },
    {
      "type": "image_picker",
      "id": "overlay_logo",
      "label": "Logo (optional)",
      "info": "Shown centered over the video."
    },
    {
      "type": "checkbox",
      "id": "overlay_use_store_logo",
      "label": "Use store logo when no logo is selected",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "overlay_logo_white",
      "label": "Make logo white",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_logo_width",
      "label": "Logo width",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 17
    },
    {
      "type": "text",
      "id": "overlay_text",
      "label": "Text",
      "info": "Leave empty for no text."
    },
    {
      "type": "font_picker",
      "id": "overlay_font",
      "label": "Text font",
      "default": "inter_n4"
    },
    {
      "type": "range",
      "id": "overlay_text_size",
      "label": "Text size",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "overlay_letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "info": "Darkens the video so the text is easier to read.",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)",
      "info": "Makes the whole banner clickable."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link accessible label",
      "default": "Custom dye program"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Video banner"
    }
  ]
}
{% endschema %}
