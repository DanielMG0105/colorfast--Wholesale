{%- liquid
  assign video = section.settings.video
  assign video_mobile = section.settings.video_mobile | default: video

  assign poster_desktop = nil
  assign poster_mobile = nil
  if section.settings.show_poster
    assign poster_source = section.settings.poster_image | default: video.preview_image
    if poster_source != blank
      assign poster_desktop = poster_source | image_url: width: 2400
    endif
    assign poster_source_mobile = section.settings.poster_image_mobile | default: section.settings.poster_image | default: video_mobile.preview_image
    if poster_source_mobile != blank
      assign poster_mobile = poster_source_mobile | image_url: width: 1200
    endif
  endif

  assign ratio = 3.5
  if video != blank and video.aspect_ratio
    assign ratio = video.aspect_ratio
  endif
  assign ratio_mobile = ratio
  if video_mobile != blank and video_mobile.aspect_ratio
    assign ratio_mobile = video_mobile.aspect_ratio
  endif
-%}

<div
  class="video-banner video-banner--{{ section.settings.height_mode }}"
  data-footer-bg="ignore"
  style="
    --vb-ratio: {{ ratio }};
    --vb-ratio-mobile: {{ ratio_mobile }};
    --vb-height: {{ section.settings.height }}px;
    --vb-height-mobile: {{ section.settings.height_mobile }}px;
    --vb-position: {{ section.settings.video_position }};
    --vb-bg: {{ section.settings.background_color }};
  "
>
  {%- if video != blank -%}
    <div class="video-banner__media{% if video_mobile != video %} video-banner__media--desktop{% endif %}">
      {{
        video
        | video_tag:
          poster: poster_desktop,
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata',
          class: 'video-banner__video'
      }}
    </div>
    {%- if video_mobile != video -%}
      <div class="video-banner__media video-banner__media--mobile">
        {{
          video_mobile
          | video_tag:
            poster: poster_mobile,
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            class: 'video-banner__video'
        }}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="video-banner__media">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'video-banner__placeholder' }}
    </div>
  {%- endif -%}

  {%- if section.settings.link != blank -%}
    <a class="video-banner__link" href="{{ section.settings.link }}">
      <span class="visually-hidden">{{ section.settings.link_label | default: 'View more' | escape }}</span>
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .video-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--vb-bg);
  }

  .video-banner--ratio {
    aspect-ratio: var(--vb-ratio-mobile);

    @media screen and (min-width: 750px) {
      aspect-ratio: var(--vb-ratio);
    }
  }

  .video-banner--custom {
    height: var(--vb-height-mobile);

    @media screen and (min-width: 750px) {
      height: var(--vb-height);
    }
  }

  .video-banner__media {
    position: absolute;
    inset: 0;
  }

  .video-banner__media--desktop {
    display: none;

    @media screen and (min-width: 750px) {
      display: block;
    }
  }

  .video-banner__media--mobile {
    display: block;

    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  .video-banner__video,
  .video-banner__media video,
  .video-banner__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--vb-position);
  }

  .video-banner__placeholder {
    opacity: 0.3;
  }

  .video-banner__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video banner",
  "tag": "section",
  "class": "section-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays muted, looped and autoplayed."
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video (optional)"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "Video position",
      "info": "Which part of the video stays visible when it is cropped.",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Height mode",
      "options": [
        { "value": "ratio", "label": "Video aspect ratio" },
        { "value": "custom", "label": "Custom height" }
      ],
      "default": "ratio"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 150,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 350,
      "visible_if": "{{ section.settings.height_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 200,
      "visible_if": "{{ section.settings.height_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Poster"
    },
    {
      "type": "checkbox",
      "id": "show_poster",
      "label": "Show poster",
      "info": "Image displayed while the video loads. Uses the video's preview image unless a custom one is set.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Custom poster (optional)",
      "visible_if": "{{ section.settings.show_poster }}"
    },
    {
      "type": "image_picker",
      "id": "poster_image_mobile",
      "label": "Custom mobile poster (optional)",
      "visible_if": "{{ section.settings.show_poster }}"
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)",
      "info": "Makes the whole banner clickable."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link accessible label",
      "default": "Custom dye program"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Video banner"
    }
  ]
}
{% endschema %}
