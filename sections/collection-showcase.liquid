{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
  assign button_font = section.settings.button_font

  assign button_link = section.settings.button_link
  if button_link == blank and collection != blank
    assign button_link = collection.url
  endif
-%}

<style>
  {{ button_font | font_face: font_display: 'swap' }}
</style>

<div
  class="collection-showcase"
  style="
    --cs-bg: {{ section.settings.background_color }};
    --cs-text: {{ section.settings.text_color }};
    --cs-columns: {{ section.settings.columns_desktop }};
    --cs-columns-mobile: {{ section.settings.columns_mobile }};
    --cs-gap: {{ section.settings.gap }}px;
    --cs-margin: {{ section.settings.side_margin }}px;
    --cs-pt: {{ section.settings.padding_top }}px;
    --cs-pb: {{ section.settings.padding_bottom }}px;
    --cs-ratio: {{ section.settings.image_ratio }};
    --cs-blend: {% if section.settings.blend_white %}multiply{% else %}normal{% endif %};
    --cs-button-gap: {{ section.settings.button_spacing }}px;
    --cs-btn-font-family: {{ button_font.family }}, {{ button_font.fallback_families }};
    --cs-btn-font-weight: {{ button_font.weight }};
    --cs-btn-font-style: {{ button_font.style }};
    --cs-btn-size: {{ section.settings.button_font_size }}px;
    --cs-btn-ls: {{ section.settings.button_letter_spacing | divided_by: 1000.0 }}em;
    --cs-btn-width: {{ section.settings.button_width }}px;
    --cs-btn-height: {{ section.settings.button_height }}px;
    --cs-btn-border: {{ section.settings.button_border_color }};
    --cs-btn-border-width: {{ section.settings.button_border_width }}px;
    --cs-btn-text: {{ section.settings.button_text_color }};
    --cs-btn-bg: {{ section.settings.button_background }};
    --cs-btn-hover-bg: {{ section.settings.button_hover_background }};
    --cs-btn-hover-text: {{ section.settings.button_hover_text_color }};
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="collection-showcase__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- liquid
    assign layout = section.settings.layout
    assign grid_class = ''
    if layout == 'slider'
      assign grid_class = ' collection-showcase__grid--slider'
    elsif layout == 'slider_mobile'
      assign grid_class = ' collection-showcase__grid--slider-mobile'
    endif
  -%}

  <collection-showcase-slider class="collection-showcase__slider">
  {%- if layout == 'slider' and section.settings.show_arrows -%}
    <button
      type="button"
      class="collection-showcase__arrow collection-showcase__arrow--prev"
      aria-label="{{ 'accessibility.slideshow_previous' | t }}"
      data-direction="-1"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  {%- endif -%}

  <ul class="collection-showcase__grid{{ grid_class }} list-unstyled" role="list" data-track>
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        <li class="collection-showcase__item">
          <a class="collection-showcase__link" href="{{ product.url }}">
            <div class="collection-showcase__media">
              {%- if product.featured_media -%}
                {%- assign image_alt = product.featured_media.alt | default: product.title -%}
                {{
                  product.featured_media
                  | image_url: width: 1200
                  | image_tag:
                    widths: '300, 450, 600, 800, 1000, 1200',
                    sizes: '(min-width: 750px) 25vw, 50vw',
                    loading: 'lazy',
                    alt: image_alt,
                    class: 'collection-showcase__image'
                }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'collection-showcase__image collection-showcase__placeholder' }}
              {%- endif -%}
            </div>

            {%- if section.settings.show_title or section.settings.show_price -%}
              <div class="collection-showcase__info">
                {%- if section.settings.show_title -%}
                  <span class="collection-showcase__title">{{ product.title | escape }}</span>
                {%- endif -%}
                {%- if section.settings.show_price -%}
                  <span class="collection-showcase__price">{{ product.price | money }}</span>
                {%- endif -%}
              </div>
            {%- else -%}
              <span class="visually-hidden">{{ product.title | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        <li class="collection-showcase__item">
          <div class="collection-showcase__media">
            {%- capture placeholder -%}product-apparel-{{ forloop.index | modulo: 4 | plus: 1 }}{%- endcapture -%}
            {{ placeholder | placeholder_svg_tag: 'collection-showcase__image collection-showcase__placeholder' }}
          </div>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>

  {%- if layout == 'slider' and section.settings.show_arrows -%}
    <button
      type="button"
      class="collection-showcase__arrow collection-showcase__arrow--next"
      aria-label="{{ 'accessibility.slideshow_next' | t }}"
      data-direction="1"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  {%- endif -%}
  </collection-showcase-slider>

  {%- if section.settings.button_label != blank -%}
    <div class="collection-showcase__actions">
      <a
        class="collection-showcase__button"
        {% if button_link != blank %}
          href="{{ button_link }}"
        {% else %}
          role="link" aria-disabled="true"
        {% endif %}
      >
        {{- section.settings.button_label | escape -}}
      </a>
    </div>
  {%- endif -%}
</div>

{%- if section.settings.layout != 'grid' -%}
  <script type="module">
    if (!customElements.get('collection-showcase-slider')) {
      customElements.define(
        'collection-showcase-slider',
        class extends HTMLElement {
          connectedCallback() {
            this.track = this.querySelector('[data-track]');
            this.prev = this.querySelector('[data-direction="-1"]');
            this.next = this.querySelector('[data-direction="1"]');
            this.querySelectorAll('[data-direction]').forEach((button) =>
              button.addEventListener('click', () => this.go(Number(button.dataset.direction)))
            );
            this.update = this.update.bind(this);
            this.track.addEventListener('scroll', this.update, { passive: true });
            this.observer = new ResizeObserver(this.update);
            this.observer.observe(this.track);
          }

          disconnectedCallback() {
            this.observer?.disconnect();
          }

          // Scroll by the visible width, snapped to whole items
          go(direction) {
            const item = this.track.firstElementChild;
            if (!item) return;
            const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
            const step = item.offsetWidth + gap;
            const perPage = Math.max(1, Math.floor((this.track.clientWidth + gap) / step));
            const rtl = getComputedStyle(this).direction === 'rtl' ? -1 : 1;
            this.track.scrollBy({ left: direction * rtl * step * perPage, behavior: 'smooth' });
          }

          update() {
            const max = this.track.scrollWidth - this.track.clientWidth;
            const position = Math.abs(this.track.scrollLeft);
            this.toggleAttribute('scrollable', max > 1);
            if (this.prev) this.prev.disabled = position <= 1;
            if (this.next) this.next.disabled = position >= max - 1;
          }
        }
      );
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .collection-showcase {
    background-color: var(--cs-bg);
    color: var(--cs-text);
    padding: calc(var(--cs-pt) * 0.6) 16px calc(var(--cs-pb) * 0.6);
    /* Contain the full-bleed slider track so it never causes page-level horizontal scroll */
    overflow-x: hidden;
    overflow-x: clip;

    @media screen and (min-width: 750px) {
      padding: var(--cs-pt) var(--cs-margin) var(--cs-pb);
    }
  }

  .collection-showcase__heading {
    margin: 0 0 32px;
    text-align: center;
    color: var(--cs-text);
  }

  .collection-showcase__grid {
    display: grid;
    grid-template-columns: repeat(var(--cs-columns-mobile), minmax(0, 1fr));
    gap: calc(var(--cs-gap) * 0.5);
    margin: 0;
    padding: 0;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(var(--cs-columns), minmax(0, 1fr));
      gap: var(--cs-gap);
    }
  }

  .collection-showcase__slider {
    position: relative;
    display: block;
    min-width: 0;
  }

  /* Slider: horizontal track with scroll snap. Mobile shows a peek of the next item. */
  .collection-showcase__grid--slider,
  .collection-showcase__grid--slider-mobile {
    @media screen and (max-width: 749px) {
      --cs-slider-gap: calc(var(--cs-gap) * 0.5);

      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: calc(
        (100% - (var(--cs-columns-mobile) - 1) * var(--cs-slider-gap)) / (var(--cs-columns-mobile) + 0.25)
      );
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 16px;
      scrollbar-width: none;
      margin-inline: -16px;
      padding-inline: 16px;
    }
  }

  .collection-showcase__grid--slider {
    @media screen and (min-width: 750px) {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: calc((100% - (var(--cs-columns) - 1) * var(--cs-gap)) / var(--cs-columns));
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
  }

  .collection-showcase__grid--slider::-webkit-scrollbar,
  .collection-showcase__grid--slider-mobile::-webkit-scrollbar {
    display: none;
  }

  .collection-showcase__grid--slider > .collection-showcase__item,
  .collection-showcase__grid--slider-mobile > .collection-showcase__item {
    scroll-snap-align: start;
  }

  .collection-showcase__arrow {
    display: none;
    position: absolute;
    top: 50%;
    z-index: 1;
    width: 44px;
    height: 44px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--cs-btn-border);
    border-radius: 50%;
    background-color: var(--cs-bg);
    color: var(--cs-text);
    cursor: pointer;
    transform: translateY(-50%);
    transition: background-color 0.25s ease, color 0.25s ease, opacity 0.25s ease;

    svg {
      width: 20px;
      height: 20px;
    }
  }

  @media screen and (min-width: 750px) {
    .collection-showcase__slider[scrollable] > .collection-showcase__arrow {
      display: flex;
    }
  }

  .collection-showcase__arrow--prev {
    inset-inline-start: calc(min(var(--cs-margin), 64px) * -0.75);
  }

  .collection-showcase__arrow--next {
    inset-inline-end: calc(min(var(--cs-margin), 64px) * -0.75);
  }

  [dir='rtl'] .collection-showcase__arrow svg {
    transform: scaleX(-1);
  }

  .collection-showcase__arrow:hover:not([disabled]) {
    background-color: var(--cs-text);
    color: var(--cs-bg);
  }

  .collection-showcase__arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .collection-showcase__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .collection-showcase__media {
    position: relative;
    aspect-ratio: var(--cs-ratio);
    overflow: hidden;
  }

  .collection-showcase__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: var(--cs-blend);
    transition: transform 0.4s ease;
  }

  .collection-showcase__placeholder {
    fill: currentColor;
    opacity: 0.25;
  }

  @media (hover: hover) {
    .collection-showcase__link:hover .collection-showcase__image {
      transform: scale(1.03);
    }
  }

  .collection-showcase__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-top: 12px;
    text-align: center;
    font-size: 14px;
  }

  .collection-showcase__actions {
    display: flex;
    justify-content: center;
    margin-top: calc(var(--cs-button-gap) * 0.6);

    @media screen and (min-width: 750px) {
      margin-top: var(--cs-button-gap);
    }
  }

  .collection-showcase__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(100%, var(--cs-btn-width));
    min-height: calc(var(--cs-btn-height) * 0.75);
    padding: 0 32px;
    border: var(--cs-btn-border-width) solid var(--cs-btn-border);
    border-radius: 999px;
    background-color: var(--cs-btn-bg);
    color: var(--cs-btn-text);
    font-family: var(--cs-btn-font-family);
    font-style: var(--cs-btn-font-style);
    font-weight: var(--cs-btn-font-weight);
    font-size: calc(var(--cs-btn-size) * 0.8);
    letter-spacing: var(--cs-btn-ls);
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.25s ease, color 0.25s ease;

    @media screen and (min-width: 750px) {
      min-height: var(--cs-btn-height);
      font-size: var(--cs-btn-size);
    }
  }

  .collection-showcase__button:hover,
  .collection-showcase__button:focus-visible {
    background-color: var(--cs-btn-hover-bg);
    color: var(--cs-btn-hover-text);
  }

  .collection-showcase__button:focus-visible {
    outline: 2px solid var(--cs-btn-border);
    outline-offset: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection showcase",
  "tag": "section",
  "class": "section-collection-showcase",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider" },
        { "value": "slider_mobile", "label": "Slider on mobile only" }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show slider arrows (desktop)",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "5 / 4", "label": "Landscape (5:4)" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "checkbox",
      "id": "blend_white",
      "label": "Blend white image backgrounds",
      "info": "Useful when photos have a white background: it blends into the section color.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show product title",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": false
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between products",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "side_margin",
      "label": "Side margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 108
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Text",
      "default": "Shop our bestsellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link",
      "info": "If empty, links to the selected collection."
    },
    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Font",
      "default": "figtree_n4"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Text size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "button_letter_spacing",
      "label": "Letter spacing",
      "info": "In thousandths of an em (30 = 0.03em).",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "button_width",
      "label": "Width",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 550
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Height",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 78
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Border width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background",
      "alpha": true,
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Background (hover)",
      "alpha": true,
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Text color (hover)",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_spacing",
      "label": "Space above button",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors and spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#c6c6c4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Collection showcase"
    }
  ]
}
{% endschema %}
