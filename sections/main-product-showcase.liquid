{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign current_variant = product.selected_or_first_available_variant
  assign color_option_names = section.settings.color_option_names | downcase | split: ','

  assign color_option_position = 0
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    for accepted in color_option_names
      assign accepted_name = accepted | strip
      if option_name == accepted_name
        assign color_option_position = option.position
        break
      endif
    endfor
    if color_option_position > 0
      break
    endif
  endfor

  # Only show images whose alt text names the selected color.
  # Each image belongs to the longest color value found in its alt ("jet black" wins over "black").
  assign matched_media_ids = '|'
  if color_option_position > 0
    assign color_index = color_option_position | minus: 1
    assign color_option = product.options_with_values[color_index]
    assign selected_color_lower = color_option.selected_value | downcase | strip
    assign color_values_str = ''
    for color_value in color_option.values
      assign color_values_str = color_values_str | append: color_value | downcase | strip | append: '|||'
    endfor
    assign color_values_lower = color_values_str | split: '|||'

    for media in product.media
      assign media_alt_lower = media.alt | downcase
      assign media_color = ''
      for color_value in color_values_lower
        if color_value != blank and media_alt_lower contains color_value and color_value.size > media_color.size
          assign media_color = color_value
        endif
      endfor
      if media_color == selected_color_lower
        assign matched_media_ids = matched_media_ids | append: media.id | append: '|'
      endif
    endfor
  endif

  # If no image matches the selected color, show every image instead of an empty gallery
  assign filter_media = false
  if matched_media_ids != '|'
    assign filter_media = true
  endif

  assign size_option_position = 0
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    if option_name == 'size' or option_name == 'talla'
      assign size_option_position = option.position
      break
    endif
  endfor

  assign tiers_source = product.metafields.custom.wholesale_tiers.value | default: section.settings.wholesale_tiers
  assign tier_lines = tiers_source | newline_to_br | split: '<br />'
  assign related_products = product.metafields.custom.variants_products.value
  if related_products == blank
    assign related_products = product.metafields.custom.variants_color.value
  endif
  assign form_id = 'ProductShowcaseForm-' | append: section.id

-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  /* Mobile product media is a real horizontal track; the showcase is a custom section. */
  @media screen and (max-width: 749px) {
    product-showcase.product-showcase {
      display: block;
      max-width: 100%;
      overflow-x: clip;
    }

    product-showcase.product-showcase .product-showcase__grid,
    product-showcase.product-showcase .product-showcase__info,
    product-showcase.product-showcase .product-showcase__media-viewport {
      min-width: 0;
      max-width: 100%;
    }

    product-showcase.product-showcase [data-media-list] {
      position: relative;
      display: flex !important;
      flex-flow: row nowrap !important;
      gap: 0 !important;
      width: 100%;
      max-width: 100%;
      overflow-x: auto !important;
      overscroll-behavior-inline: contain;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      touch-action: pan-x pan-y;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    product-showcase.product-showcase [data-media-list]::-webkit-scrollbar {
      display: none;
    }

    product-showcase.product-showcase [data-media-list] > .product-showcase__figure {
      display: block;
      flex: 0 0 100%;
      width: 100%;
      min-width: 100%;
      scroll-snap-align: start;
    }

    product-showcase.product-showcase [data-media-list] > .product-showcase__figure[hidden] {
      display: none !important;
    }

    product-showcase.product-showcase .product-showcase__bulk-grid,
    product-showcase.product-showcase .product-showcase__bulk-content,
    product-showcase.product-showcase .product-showcase__bulk-wrap,
    product-showcase.product-showcase .vbog__scroll-wrapper {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    product-showcase.product-showcase .product-showcase__bulk-content {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }

    product-showcase.product-showcase .vbog__scroll-wrapper {
      overflow-x: auto !important;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
    }

    product-showcase.product-showcase .product-showcase__bulk-grid .vbog__table {
      width: max-content !important;
      min-width: 100% !important;
      table-layout: fixed !important;
      border-spacing: 2px !important;
    }

    product-showcase.product-showcase .product-showcase__bulk-grid .vbog__table col:not(.vbog__color-column) {
      width: 58px;
    }

    product-showcase.product-showcase .product-showcase__bulk-grid .vbog__cell {
      padding-inline: 1px;
      font-size: 9px;
      letter-spacing: 0;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    product-showcase.product-showcase .product-showcase__bulk-grid .vbog__cell--label,
    product-showcase.product-showcase .product-showcase__bulk-grid .vbog__cell--size-header,
    product-showcase.product-showcase .product-showcase__bulk-grid .vbog__cell--total-label {
      font-size: 9px;
      letter-spacing: 0;
    }

    product-showcase.product-showcase .product-showcase__bulk-grid .vbog__table col.vbog__color-column {
      width: 76px;
    }

    product-showcase.product-showcase .product-showcase__gallery-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      padding: 12px 0 0;
    }

    product-showcase.product-showcase .product-showcase__gallery-control {
      display: inline-flex;
      width: 40px;
      height: 40px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--ps-border);
      border-radius: 50%;
      background: var(--ps-bg);
      color: var(--ps-text);
      font: inherit;
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      touch-action: manipulation;
    }

    product-showcase.product-showcase .product-showcase__gallery-status {
      min-width: 48px;
      text-align: center;
      font-size: 13px;
      font-variant-numeric: tabular-nums;
    }

    product-showcase.product-showcase .product-showcase__gallery-control:disabled {
      opacity: 0.4;
      cursor: default;
    }
  }
</style>

<product-showcase
  class="product-showcase"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-color-position="{{ color_option_position }}"
  data-size-position="{{ size_option_position }}"
  style="
    --ps-bg: {{ section.settings.background_color }};
    --ps-text: {{ section.settings.text_color }};
    --ps-border: {{ section.settings.border_color }};
    --ps-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --ps-heading-weight: {{ heading_font.weight }};
    --ps-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --ps-body-weight: {{ body_font.weight }};
    --ps-title-size: {{ section.settings.title_size }}px;
    --ps-media-width: {{ section.settings.media_width }}%;
    --ps-margin: {{ section.settings.side_margin }}px;
    --ps-margin-right: {{ section.settings.side_margin_right }}px;
    --ps-gap: {{ section.settings.column_gap }}%;
    --ps-pt: {{ section.settings.padding_top }}px;
    --ps-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="product-showcase__grid">
    <div class="product-showcase__media-viewport">
      <div class="product-showcase__media" data-media-list>
        {%- for media in product.media -%}
          {%- assign media_needle = '|' | append: media.id | append: '|' -%}
          <figure
            class="product-showcase__figure"
            data-media-id="{{ media.id }}"
            data-media-alt="{{ media.alt | downcase | escape }}"
            {% if filter_media %}{% unless matched_media_ids contains media_needle %}hidden{% endunless %}{% endif %}
          >
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- assign media_alt = media.alt | default: product.title | escape -%}
                {{
                  media
                  | image_url: width: 2000
                  | image_tag:
                    widths: '600, 900, 1200, 1600, 2000',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    loading: 'lazy',
                    alt: media_alt,
                    class: 'product-showcase__image'
                }}
              {%- when 'video' -%}
                {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'product-showcase__image' }}
              {%- else -%}
                {{ media | media_tag: class: 'product-showcase__image' }}
            {%- endcase -%}
          </figure>
        {%- else -%}
          <figure class="product-showcase__figure">
            {{ 'product-apparel-1' | placeholder_svg_tag: 'product-showcase__image product-showcase__placeholder' }}
          </figure>
        {%- endfor -%}
      </div>
      {% if product.media.size > 1 %}
        <div class="product-showcase__gallery-controls" data-gallery-controls aria-label="Image navigation">
          <button class="product-showcase__gallery-control" type="button" data-gallery-previous aria-label="Previous image">‹</button>
          <span class="product-showcase__gallery-status" data-gallery-status aria-live="polite">1 / {{ product.media.size }}</span>
          <button class="product-showcase__gallery-control" type="button" data-gallery-next aria-label="Next image">›</button>
        </div>
      {% endif %}
    </div>

    <div class="product-showcase__info">
      <div class="product-showcase__sticky">
        <h1 class="product-showcase__title">{{ product.title | escape }}</h1>

        <p class="product-showcase__price" data-price data-wpd-product-handle="{{ product.handle }}"
data-wpd-variant-id="{{ product.selected_or_first_available_variant.id }}"
data-wpd-variant-price="{{ product.selected_or_first_available_variant.price }}"
data-wpd-variant-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price }}"
data-wpd-product-collection-ids="{% assign wpdProductCollectionIds = product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"
data-wpd-product-id="{{ product.id }}">
          {{- current_variant.price | money_with_currency -}}
        </p>

        {%- if product.description != blank -%}
          <div class="product-showcase__description rte">{{ product.description }}</div>
        {%- endif -%}

        {%- form 'product', product, id: form_id, class: 'product-showcase__form', novalidate: 'novalidate', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="product-showcase__option" data-option-position="{{ option.position }}" data-option-name="{{ option.name | escape }}">
                <legend class="product-showcase__label">
                  {{ option.name | escape }}: <span data-option-value>{% render 'variant-option-label', value: option.selected_value, option_name: option.name %}</span>
                </legend>

                <div class="product-showcase__values{% if option.position == color_option_position %} product-showcase__values--swatches{% endif %}">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign input_id = form_id | append: '-' | append: option.position | append: '-' | append: forloop.index
                      assign is_color = false
                      if option.position == color_option_position
                        assign is_color = true
                        assign swatch_color = value.swatch.color | default: value
                        assign is_light = false
                        if value.swatch.color
                          assign brightness = value.swatch.color | color_brightness
                          if brightness > 200
                            assign is_light = true
                          endif
                        else
                          assign value_handle = value | handle
                          if value_handle contains 'white' or value_handle contains 'natural' or value_handle contains 'cream' or value_handle contains 'ivory' or value_handle contains 'pfd'
                            assign is_light = true
                          endif
                        endif
                      endif
                    -%}
                    <input
                      type="radio"
                      class="product-showcase__radio"
                      id="{{ input_id }}"
                      name="option{{ option.position }}"
                      value="{{ value | escape }}"
                      data-option-input
                      data-swatch-product-id="{% if is_color %}{{ product.id }}{% endif %}"
                      {% if value.selected %}
                        checked
                      {% endif %}
                    >
                    {%- if is_color -%}
                      <label
                        for="{{ input_id }}"
                        class="product-showcase__swatch{% if is_light %} product-showcase__swatch--light{% endif %}"
                        data-swatch-product-id="{{ product.id }}"
                        style="{% if value.swatch.image %}background-image: url({{ value.swatch.image | image_url: width: 72 }});{% else %}background-color: {{ swatch_color }};{% endif %}"
                        title="{{ value | escape }}"
                      >
                        <span class="visually-hidden">{{ value | escape }}</span>
                      </label>
                    {%- else -%}
                      <label for="{{ input_id }}" class="product-showcase__pill">{% render 'variant-option-label', value: value.name, option_name: option.name %}</label>
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if option.position == color_option_position and related_products != blank -%}
                    {%- for related_product in related_products -%}
                      {%- unless related_product.id == product.id -%}
                      {%- liquid
                        assign related_color = related_product.title
                        assign related_swatch_color = blank
                        assign related_swatch_image = blank
                        for related_option in related_product.options_with_values
                          assign related_option_name = related_option.name | downcase | strip
                          for accepted in color_option_names
                            assign accepted_name = accepted | strip
                            if related_option_name == accepted_name
                              assign related_color_value = related_option.values.first
                              assign related_color = related_color_value.name | default: related_color_value
                              assign related_swatch_color = related_color_value.swatch.color
                              assign related_swatch_image = related_color_value.swatch.image
                              break
                            endif
                          endfor
                          if related_swatch_color != blank or related_swatch_image != blank
                            break
                          endif
                        endfor
                      -%}
                      <a
                        class="product-showcase__swatch product-showcase__related-swatch"
                        data-swatch-product-id="{{ related_product.id }}"
                        href="{{ related_product.url }}"
                        title="{{ related_color | escape }}"
                        aria-label="View {{ related_color | escape }}"
                        style="{% if related_swatch_image %}background-image: url({{ related_swatch_image | image_url: width: 72 }});{% elsif related_swatch_color != blank %}background-color: {{ related_swatch_color }};{% else %}background-image: url({{ related_product.featured_image | image_url: width: 72 }});{% endif %}"
                      ><span class="visually-hidden">{{ related_color | escape }}</span></a>
                      {%- endunless -%}
                    {%- endfor -%}
                  {%- endif -%}

                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          <div class="product-showcase__buy">
            <div class="product-showcase__quantity">
              <button type="button" class="product-showcase__step" data-step="-1" aria-label="Decrease quantity">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>
              </button>
              <input
                class="product-showcase__qty-input"
                type="number"
                name="quantity"
                value="1"
                min="1"
                inputmode="numeric"
                aria-label="Quantity"
                data-quantity
              >
              <button type="button" class="product-showcase__step" data-step="1" aria-label="Increase quantity">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8 3v10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>
              </button>
            </div>

            <button
              type="submit"
              class="product-showcase__add"
              data-add-button
              {% unless current_variant.available %}
                disabled
              {% endunless %}
            >
              <span data-add-label>
                {%- if current_variant.available -%}
                  {{ section.settings.add_label | escape }}
                {%- else -%}
                  {{ section.settings.sold_out_label | escape }}
                {%- endif -%}
              </span>
            </button>
          </div>

          <p class="product-showcase__message" role="status" data-message hidden></p>
          {%- comment -%} Filled by the WCP app; kept hidden and mirrored into the wholesale table below {%- endcomment -%}
          <div id='wcp_vd_table' data-app-tiers></div>
        {%- endform -%}

        {%- if customer and section.settings.show_bulk_grid and size_option_position > 0 and color_option_position > 0 -%}
          {%- assign size_index = size_option_position | minus: 1 -%}
          {%- assign color_index = color_option_position | minus: 1 -%}
          {%- assign size_option = product.options_with_values[size_index] -%}
          {%- assign color_option = product.options_with_values[color_index] -%}
          <details class="product-showcase__bulk-grid" open>
            <summary><span class="product-showcase__plus" aria-hidden="true"></span>View Bulk Order Grid</summary>
            <div class="product-showcase__accordion-body product-showcase__bulk-content">
            {%- if section.settings.bulk_hint != blank -%}<p class="product-showcase__hint">{{ section.settings.bulk_hint | escape }}</p>{%- endif -%}
            <div class="product-showcase__bulk-wrap vbog__scroll-wrapper">
              <div class="vbog__table-clip">
              <table class="product-showcase__table product-showcase__bulk-table vbog__table" role="table" aria-label="View Bulk Order Grid">
                <colgroup><col class="vbog__color-column">{%- for size in size_option.values -%}<col>{%- endfor -%}</colgroup>
                <thead class="vbog__thead"><tr class="vbog__row vbog__row--header" role="row"><th class="vbog__cell vbog__cell--label" scope="col" role="columnheader">COLOR</th>
                  {%- for value in size_option.values -%}<th class="vbog__cell vbog__cell--size-header" scope="col" role="columnheader">{% render 'variant-option-label', value: value.name, option_name: size_option.name %}</th>{%- endfor -%}
                </tr></thead>
                <tbody class="vbog__tbody">
                  {%- for color in color_option.values -%}
                    {%- assign grid_color_label = color.name | default: color -%}
                    {%- assign grid_color_label_lower = grid_color_label | downcase | strip -%}
                    {%- if grid_color_label_lower == 'pfd' or grid_color_label_lower contains 'prepared for dye' -%}{%- assign grid_color_label = 'PFD' -%}{%- endif -%}
                    {%- assign grid_color_lower = grid_color_label_lower -%}
                    {%- assign grid_swatch = color.swatch.color | default: color -%}
                    {%- assign grid_swatch_is_dark = false -%}
                    {%- if color.swatch.color -%}
                      {%- assign grid_swatch_brightness = color.swatch.color | color_brightness -%}
                      {%- if grid_swatch_brightness < 128 -%}{%- assign grid_swatch_is_dark = true -%}{%- endif -%}
                    {%- elsif grid_color_lower contains 'black' or grid_color_lower contains 'navy' or grid_color_lower contains 'caviar' -%}
                      {%- assign grid_swatch_is_dark = true -%}
                    {%- endif -%}
                    <tr class="vbog__row vbog__row--color" data-color="{{ color | escape }}" role="row"><td class="vbog__cell vbog__cell--swatch" scope="row" role="rowheader"><div class="vbog__swatch{% if grid_swatch_is_dark %} vbog__swatch--dark{% endif %}" title="{{ color | escape }}" style="{% if color.swatch.image %}background-image: url({{ color.swatch.image | image_url: width: 72 }});{% else %}background-color: {{ grid_swatch }};{% endif %}"><span class="vbog__swatch-name">{{ grid_color_label | upcase }}</span></div></td>
                      {%- for size in size_option.values -%}
                        {%- assign grid_variant = nil -%}
                        {%- for variant in product.variants -%}
                          {%- if variant.options[color_index] == color and variant.options[size_index] == size -%}{%- assign grid_variant = variant -%}{%- break -%}{%- endif -%}
                        {%- endfor -%}
                        {%- if grid_variant -%}
                          {%- assign grid_max = '' -%}
                          {%- if grid_variant.inventory_management == 'shopify' and grid_variant.inventory_policy == 'deny' -%}{%- assign grid_max = grid_variant.inventory_quantity -%}{%- endif -%}
                          <td class="vbog__cell vbog__cell--variant vbog__qty-cell product-showcase__bulk-cell{% unless grid_variant.available %} vbog__cell--disabled is-unavailable{% endunless %}" data-variant-id="{{ grid_variant.id }}" data-size="{{ size | escape }}" data-color="{{ color | escape }}" role="gridcell"{% if grid_variant.available %} tabindex="0" aria-label="{{ color | escape }} / {{ size | escape }} – Quantity"{% else %} aria-disabled="true"{% endif %}><span class="vbog__cell-inventory" data-vbog-display data-inventory="{{ grid_variant.inventory_quantity | default: 0 }}">{{ grid_variant.inventory_quantity | default: 0 }}</span><input type="number" class="vbog__cell-qty-input" min="0" step="1" inputmode="numeric"{% if grid_max != blank %} max="{{ grid_max }}"{% endif %} aria-label="{{ color | escape }} / {% render 'variant-option-label', value: size.name, option_name: size_option.name %} quantity" data-grid-qty data-grid-size="{{ size | escape }}" data-variant-id="{{ grid_variant.id }}"{% unless grid_variant.available %} disabled{% endunless %}></td>
                        {%- else -%}<td class="vbog__cell vbog__cell--empty" aria-hidden="true">—</td>{%- endif -%}
                      {%- endfor -%}
                    </tr>
              {%- endfor -%}
                  {%- for related_product in related_products -%}
                    {%- unless related_product.id == product.id -%}
                      {%- assign related_color_position = 0 -%}
                      {%- assign related_size_position = 0 -%}
                      {%- for related_option in related_product.options_with_values -%}
                        {%- assign related_option_name = related_option.name | downcase | strip -%}
                        {%- if related_color_position == 0 -%}
                          {%- for accepted in color_option_names -%}
                            {%- if related_option_name == accepted -%}{%- assign related_color_position = related_option.position -%}{%- break -%}{%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}
                        {%- if related_size_position == 0 -%}
                          {%- if related_option_name == 'size' or related_option_name == 'talla' -%}{%- assign related_size_position = related_option.position -%}{%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if related_color_position > 0 and related_size_position > 0 -%}
                        {%- assign related_color_index = related_color_position | minus: 1 -%}
                        {%- assign related_size_index = related_size_position | minus: 1 -%}
                        {%- assign related_color_value = related_product.options_with_values[related_color_index].values.first -%}
                        {%- assign related_color_label = related_color_value.name | default: related_color_value -%}
                        {%- assign related_color_lower = related_color_label | downcase | strip -%}
                        {%- if related_color_lower == 'pfd' or related_color_lower contains 'prepared for dye' -%}{%- assign related_color_label = 'PFD' -%}{%- endif -%}
                        {%- assign related_swatch = related_color_value.swatch.color | default: related_color_value -%}
                        {%- assign related_is_dark = false -%}
                        {%- if related_color_value.swatch.color -%}{%- assign related_brightness = related_color_value.swatch.color | color_brightness -%}{%- if related_brightness < 128 -%}{%- assign related_is_dark = true -%}{%- endif -%}{%- elsif related_color_lower contains 'black' or related_color_lower contains 'navy' or related_color_lower contains 'caviar' -%}{%- assign related_is_dark = true -%}{%- endif -%}
                        <tr class="vbog__row vbog__row--color" data-color="{{ related_color_label | escape }}" data-related-product-id="{{ related_product.id }}" role="row"><td class="vbog__cell vbog__cell--swatch" scope="row" role="rowheader"><div class="vbog__swatch{% if related_is_dark %} vbog__swatch--dark{% endif %}" title="{{ related_color_label | escape }}" style="{% if related_color_value.swatch.image %}background-image: url({{ related_color_value.swatch.image | image_url: width: 72 }});{% elsif related_color_value.swatch.color %}background-color: {{ related_swatch }};{% else %}background-image: url({{ related_product.featured_image | image_url: width: 72 }});{% endif %}"><span class="vbog__swatch-name">{{ related_color_label | upcase }}</span></div></td>
                          {%- for size in size_option.values -%}
                            {%- assign related_grid_variant = nil -%}
                            {%- for candidate_variant in related_product.variants -%}
                              {%- if candidate_variant.options[related_size_index] == size -%}{%- assign related_grid_variant = candidate_variant -%}{%- break -%}{%- endif -%}
                            {%- endfor -%}
                            {%- if related_grid_variant -%}
                              {%- assign related_grid_max = '' -%}{%- if related_grid_variant.inventory_management == 'shopify' and related_grid_variant.inventory_policy == 'deny' -%}{%- assign related_grid_max = related_grid_variant.inventory_quantity -%}{%- endif -%}
                              <td class="vbog__cell vbog__cell--variant vbog__qty-cell product-showcase__bulk-cell{% unless related_grid_variant.available %} vbog__cell--disabled is-unavailable{% endunless %}" data-variant-id="{{ related_grid_variant.id }}" data-size="{{ size | escape }}" data-color="{{ related_color_label | escape }}" role="gridcell"{% if related_grid_variant.available %} tabindex="0" aria-label="{{ related_color_label | escape }} / {{ size | escape }} – Quantity"{% else %} aria-disabled="true"{% endif %}><span class="vbog__cell-inventory" data-vbog-display data-inventory="{{ related_grid_variant.inventory_quantity | default: 0 }}">{{ related_grid_variant.inventory_quantity | default: 0 }}</span><input type="number" class="vbog__cell-qty-input" min="0" step="1" inputmode="numeric"{% if related_grid_max != blank %} max="{{ related_grid_max }}"{% endif %} aria-label="{{ related_color_label | escape }} / {% render 'variant-option-label', value: size.name, option_name: size_option.name %} quantity" data-grid-qty data-grid-size="{{ size | escape }}" data-variant-id="{{ related_grid_variant.id }}"{% unless related_grid_variant.available %} disabled{% endunless %}></td>
                            {%- else -%}<td class="vbog__cell vbog__cell--empty" aria-hidden="true">—</td>{%- endif -%}
                          {%- endfor -%}
                        </tr>
                      {%- endif -%}
                    {%- endunless -%}
                  {%- endfor -%}
                </tbody>
                <tfoot class="vbog__tfoot"><tr class="vbog__total-divider" aria-hidden="true"><td colspan="{{ size_option.values.size | plus: 1 }}"></td></tr><tr class="vbog__row vbog__row--total" role="row"><td class="vbog__cell vbog__cell--total-label" role="rowheader">TOTAL</td>{%- for size in size_option.values -%}<td class="vbog__cell vbog__cell--total-value" data-grid-total="{{ size | escape }}" role="gridcell" aria-label="{{ size | escape }} total"><span>—</span></td>{%- endfor -%}</tr></tfoot>
              </table>
              </div>
            </div>
            <div class="vbog__bulk-bar" data-grid-bulk-bar hidden>
              <span class="vbog__bulk-bar-summary" data-grid-bulk-summary></span>
              <button type="button" class="product-showcase__add product-showcase__bulk-add vbog__bulk-bar-button" data-bulk-add-button disabled><span data-bulk-add-label>{{ section.settings.bulk_add_label | default: section.settings.add_label | default: 'Add to cart' | escape }}</span></button>
            </div>
            <p class="product-showcase__message" role="status" data-bulk-message hidden></p>
            </div>
          </details>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="product-showcase__accordions">
            {%- for block in section.blocks -%}
              {%- liquid
                assign block_content = block.settings.content
                if block.settings.page != blank
                  assign block_content = block.settings.page.content
                endif
                if block.settings.use_description
                  assign block_content = product.description
                endif
              -%}
              <details class="product-showcase__accordion" {{ block.shopify_attributes }}>
                <summary>
                  <span class="product-showcase__plus" aria-hidden="true"></span>
                  {{ block.settings.heading | escape }}
                </summary>
                <div class="product-showcase__accordion-body rte">{{ block_content }}</div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_wholesale and tiers_source != blank -%}
          <details class="product-showcase__wholesale" open>
            <summary>
              {{ section.settings.wholesale_heading | escape }}
              <span class="product-showcase__circle-plus" aria-hidden="true"></span>
            </summary>
            {%- if customer -%}
              <table class="product-showcase__table product-showcase__tiers">
                <tbody data-tiers>
                  {%- for line in tier_lines -%}
                    {%- assign parts = line | strip | split: ':' -%}
                    {%- if parts.size > 1 -%}
                      {%- liquid
                        # The first tier (1-99) is always the product's own price
                        if forloop.first
                          assign tier_price = current_variant.price
                        else
                          assign tier_price = parts[1] | strip | remove: '$' | times: 100
                        endif
                      -%}
                      <tr>
                        <td>{{ parts[0] | strip | escape }}</td>
                        <td>{{ tier_price | money }}</td>
                      </tr>
                    {%- endif -%}
                  {%- endfor -%}
                </tbody>
              </table>
            {%- else -%}
              <p class="product-showcase__login-prompt">
                <a href="{{ routes.account_login_url }}">Please Log in</a> / <a href="/pages/create-wholesale-account">Apply for wholesale</a>
              </p>
            {%- endif -%}
          </details>
        {%- endif -%}

      </div>
    </div>
  </div>
  <style>
    /* The app's volume table is only a data source for the wholesale table; never show it */
    #wcp_vd_table {
      display: none !important;
    }
  </style>

  {%- assign grid_variant_count = product.variants.size -%}
  {%- for related_product in related_products -%}{%- unless related_product.id == product.id -%}{%- assign grid_variant_count = grid_variant_count | plus: related_product.variants.size -%}{%- endunless -%}{%- endfor -%}
  <script type="application/json" data-variants>
    {%- assign grid_variant_index = 0 -%}
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "productId": {{ product.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money_with_currency | json }},
          "mediaId": {{ variant.featured_media.id | default: 0 }},
          "inventoryQuantity": {{ variant.inventory_quantity | json }},
          "inventoryManagement": {{ variant.inventory_management | json }}
        }{%- assign grid_variant_index = grid_variant_index | plus: 1 -%}{% if grid_variant_index < grid_variant_count %},{% endif %}
      {%- endfor -%}
      {%- for related_product in related_products -%}
        {%- unless related_product.id == product.id -%}
          {%- for variant in related_product.variants -%}
            {
              "id": {{ variant.id }},
              "productId": {{ related_product.id }},
              "options": {{ variant.options | json }},
              "available": {{ variant.available | json }},
              "price": {{ variant.price | money_with_currency | json }},
              "mediaId": {{ variant.featured_media.id | default: 0 }},
              "inventoryQuantity": {{ variant.inventory_quantity | json }},
              "inventoryManagement": {{ variant.inventory_management | json }}
            }{%- assign grid_variant_index = grid_variant_index | plus: 1 -%}{% if grid_variant_index < grid_variant_count %},{% endif %}
          {%- endfor -%}
        {%- endunless -%}
      {%- endfor -%}
    ]
  </script>
</product-showcase>

<script type="module">
  import { CartLinesUpdateEvent, CartErrorEvent } from '@shopify/events';

  if (!customElements.get('product-showcase')) {
    customElements.define(
      'product-showcase',
      class ProductShowcase extends HTMLElement {
        connectedCallback() {
          this.variants = JSON.parse(this.querySelector('[data-variants]').textContent);
          this.sortColorSwatches();
          this.mediaTrack = this.querySelector('[data-media-list]');
          this.galleryPrevious = this.querySelector('[data-gallery-previous]');
          this.galleryNext = this.querySelector('[data-gallery-next]');
          this.galleryStatus = this.querySelector('[data-gallery-status]');
          this.onGalleryScroll = () => this.updateGalleryControls();
          this.onGalleryPrevious = () => this.moveGallery(-1);
          this.onGalleryNext = () => this.moveGallery(1);
          this.mediaTrack?.addEventListener('scroll', this.onGalleryScroll, { passive: true });
          this.galleryPrevious?.addEventListener('click', this.onGalleryPrevious);
          this.galleryNext?.addEventListener('click', this.onGalleryNext);
          this.updateGalleryControls();
          this.form = this.querySelector('[data-product-form]');
          this.variantInput = this.querySelector('[data-variant-input]');
          this.quantity = this.querySelector('[data-quantity]');
          this.addButton = this.querySelector('[data-add-button]');
          this.addLabel = this.querySelector('[data-add-label]');
          this.message = this.querySelector('[data-message]');
          this.defaultLabel = this.addLabel?.textContent.trim();
          this.bulkAddButton = this.querySelector('[data-bulk-add-button]');
          this.bulkAddLabel = this.querySelector('[data-bulk-add-label]');
          this.bulkMessage = this.querySelector('[data-bulk-message]');
          this.bulkActionBar = this.querySelector('[data-grid-bulk-bar]');
          this.bulkActionSummary = this.querySelector('[data-grid-bulk-summary]');
          this.bulkDefaultLabel = this.bulkAddLabel?.textContent.trim();
          this.bulkRequestInProgress = false;

          this.querySelectorAll('[data-option-input]').forEach((input) =>
            input.addEventListener('change', () => this.onOptionChange())
          );
          this.querySelectorAll('[data-step]').forEach((button) =>
            button.addEventListener('click', () => {
              const next = Math.max(1, (parseInt(this.quantity.value, 10) || 1) + Number(button.dataset.step));
              this.quantity.value = String(next);
            })
          );
          this.form?.addEventListener('submit', (event) => this.onSubmit(event));
          this.bulkAddButton?.addEventListener('click', (event) => this.onBulkSubmit(event));
          this.querySelectorAll('[data-bulk-size]').forEach((input) => {
            input.addEventListener('input', () => this.onBulkQuantityChange(input));
            input.addEventListener('change', () => this.onBulkQuantityChange(input));
          });
          this.querySelectorAll('[data-grid-qty]').forEach((input) => {
            input.addEventListener('input', () => this.onGridQuantityChange(input));
            input.addEventListener('change', () => this.onGridQuantityChange(input));
            input.closest('.product-showcase__bulk-cell')?.addEventListener('click', (event) => {
              if (input.disabled) return;
              if (input.dataset.gridCommitted === 'true') {
                delete input.dataset.gridCommitted;
                input.value = '';
              }
              event.currentTarget.classList.add('vbog__cell--editing');
              const display = event.currentTarget.querySelector('[data-vbog-display]');
              if (display) display.textContent = display.dataset.inventory || '0';
              input.focus();
              input.select();
              this.updateGridTotals();
              this.updateBulkButtonState();
            });
            input.addEventListener('blur', () => {
              const cell = input.closest('.product-showcase__bulk-cell');
              if (input.dataset.gridCommitted === 'true') {
                cell?.classList.add('vbog__cell--editing', 'is-added');
                const display = cell?.querySelector('[data-vbog-display]');
                if (display) display.textContent = display.dataset.inventory || '0';
                return;
              }
              cell?.classList.remove('vbog__cell--editing');
              cell?.classList.toggle('is-added', Number(input.value) > 0);
              const display = cell?.querySelector('[data-vbog-display]');
              if (display) display.textContent = input.value || display.dataset.inventory || '0';
            });
          });
          this.onBulkResize = () => this.syncBulkButtonWidth();
          window.addEventListener('resize', this.onBulkResize);
          this.updateAvailability();
          this.refreshBulkQuantities();
          this.loadGridQuantitiesFromCart();
          this.updateBulkButtonState();
          requestAnimationFrame(() => this.syncBulkButtonWidth());
          this.watchAppPrice();
        }

        disconnectedCallback() {
          this.appPriceObserver?.disconnect();
          if (this.onBulkResize) window.removeEventListener('resize', this.onBulkResize);
          this.mediaTrack?.removeEventListener('scroll', this.onGalleryScroll);
          this.galleryPrevious?.removeEventListener('click', this.onGalleryPrevious);
          this.galleryNext?.removeEventListener('click', this.onGalleryNext);
        }

        gallerySlides() {
          return [...(this.mediaTrack?.querySelectorAll('.product-showcase__figure:not([hidden])') || [])];
        }

        sortColorSwatches() {
          const container = this.querySelector('.product-showcase__values--swatches');
          if (!container) return;

          const swatches = [];
          container.querySelectorAll('[data-option-input][data-swatch-product-id]').forEach((input) => {
            const label = input.nextElementSibling;
            if (label?.matches('.product-showcase__swatch')) {
              swatches.push({
                label: input.value.trim(),
                productId: input.dataset.swatchProductId,
                elements: [input, label],
              });
            }
          });
          container.querySelectorAll('a[data-swatch-product-id]').forEach((swatch) => {
            swatches.push({
              label: (swatch.title || swatch.textContent).trim(),
              productId: swatch.dataset.swatchProductId,
              elements: [swatch],
            });
          });

          swatches.sort((a, b) =>
            a.label.localeCompare(b.label, undefined, { sensitivity: 'base' }) ||
            a.productId.localeCompare(b.productId)
          );
          container.replaceChildren(...swatches.flatMap((swatch) => swatch.elements));
        }

        updateGalleryControls() {
          const slides = this.gallerySlides();
          if (!slides.length || !this.galleryStatus) return;

          const scrollLeft = this.mediaTrack.scrollLeft;
          const activeIndex = slides.reduce((closestIndex, slide, index) => {
            const currentDistance = Math.abs(slides[closestIndex].offsetLeft - scrollLeft);
            const nextDistance = Math.abs(slide.offsetLeft - scrollLeft);
            return nextDistance < currentDistance ? index : closestIndex;
          }, 0);

          this.galleryStatus.textContent = `${activeIndex + 1} / ${slides.length}`;
          const disabled = slides.length < 2;
          if (this.galleryPrevious) this.galleryPrevious.disabled = disabled;
          if (this.galleryNext) this.galleryNext.disabled = disabled;
        }

        moveGallery(direction) {
          const slides = this.gallerySlides();
          if (slides.length < 2 || !this.mediaTrack) return;

          const scrollLeft = this.mediaTrack.scrollLeft;
          const activeIndex = slides.reduce((closestIndex, slide, index) => {
            const currentDistance = Math.abs(slides[closestIndex].offsetLeft - scrollLeft);
            const nextDistance = Math.abs(slide.offsetLeft - scrollLeft);
            return nextDistance < currentDistance ? index : closestIndex;
          }, 0);
          const nextIndex = (activeIndex + direction + slides.length) % slides.length;
          this.mediaTrack.scrollTo({ left: slides[nextIndex].offsetLeft, behavior: 'smooth' });
        }

        // Wrap only the current price text inserted by WPD.
        watchAppPrice() {
          const priceElement = this.querySelector('p.product-showcase__price[data-price]');
          if (!priceElement) return;

          const syncPriceSpan = () => {
            this.wrapAppPrice(priceElement);
          };

          this.appPriceObserver = new MutationObserver(syncPriceSpan);
          this.appPriceObserver.observe(priceElement, {
            attributes: true,
            attributeFilter: ['class'],
            childList: true,
            subtree: true,
            characterData: true,
          });
          syncPriceSpan();
        }

        wrapAppPrice(priceElement = this.querySelector('p.product-showcase__price[data-price]')) {
          if (!priceElement?.classList.contains('wpd-processed')) return null;
          const existingSpan = priceElement.querySelector(':scope > [data-tier-price]');
          if (existingSpan) return existingSpan;

          const priceText = [...priceElement.childNodes].find((node) =>
            node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== ''
          );
          if (!priceText) return null;

          const formattedPrice = priceText.textContent.trim();
          const hasCompareAt = Boolean(priceElement.querySelector(':scope > s, :scope > .wpd-ext-compare-at-price'));
          const priceSpan = document.createElement('span');
          priceSpan.dataset.tierPrice = '';
          priceSpan.textContent = formattedPrice;
          priceText.replaceWith(priceSpan);
          if (hasCompareAt) priceSpan.before(document.createTextNode(' '));
          return priceSpan;
        }

        selectedOptions() {
          return [...this.querySelectorAll('[data-option-position]')].map(
            (fieldset) => fieldset.querySelector('[data-option-input]:checked')?.value
          );
        }

        findVariant(options) {
          return this.variants.find(
            (variant) =>
              String(variant.productId) === String(this.dataset.productId) &&
              variant.options.every((value, i) => value === options[i])
          );
        }

        displayOptionValue(optionName, value) {
          const label = String(value ?? '').trim();
          if (!/size|talla/i.test(optionName ?? '')) return label;

          const normalized = label.toLowerCase();
          const sizeLabels = { xxs: '2XS', xs: 'XS', sm: 'S', md: 'M', lg: 'G', xl: 'XL' };
          return sizeLabels[normalized] ?? label.toUpperCase();
        }

        onOptionChange() {
          const options = this.selectedOptions();
          this.querySelectorAll('[data-option-position]').forEach((fieldset, i) => {
            const label = fieldset.querySelector('[data-option-value]');
            if (label) label.textContent = this.displayOptionValue(fieldset.dataset.optionName, options[i]);
          });

          this.filterMediaByColor();

          const variant = this.findVariant(options);
          if (!variant) {
            this.setButton(false, this.defaultLabel);
            return;
          }

          this.variantInput.value = String(variant.id);
          this.querySelector('[data-price]').textContent = variant.price;
          this.setButton(variant.available, variant.available ? this.defaultLabel : '{{ section.settings.sold_out_label | escape }}');

          if (variant.mediaId) {
            const figure = this.querySelector(`[data-media-id="${variant.mediaId}"]`);
            const list = this.querySelector('[data-media-list]');
            if (figure && list && list.firstElementChild !== figure) list.prepend(figure);
          }
          this.mediaTrack?.scrollTo({ left: 0, behavior: 'auto' });
          this.updateGalleryControls();

          const url = new URL(window.location.href);
          url.searchParams.set('variant', String(variant.id));
          window.history.replaceState({}, '', url.toString());
          this.updateAvailability();
          this.refreshBulkQuantities();
          this.updateBulkButtonState();
        }

        // Show only images whose alt names the selected color; the longest color name found in the alt wins
        // ("jet black" over "black"). If nothing matches, all images stay visible.
        filterMediaByColor() {
          const colorPosition = Number(this.dataset.colorPosition);
          if (!colorPosition) return;

          const fieldset = this.querySelector(`[data-option-position="${colorPosition}"]`);
          const selected = fieldset?.querySelector('[data-option-input]:checked')?.value;
          if (!selected) return;

          const normalize = (value) => value.toLowerCase().trim();
          const colors = [...fieldset.querySelectorAll('[data-option-input]')]
            .map((input) => normalize(input.value))
            .filter(Boolean)
            .sort((a, b) => b.length - a.length);
          const selectedColor = normalize(selected);

          const figures = [...this.querySelectorAll('[data-media-list] [data-media-id]')];
          const matches = figures.filter((figure) => {
            const alt = normalize(figure.dataset.mediaAlt || '');
            return colors.find((color) => alt.includes(color)) === selectedColor;
          });

          figures.forEach((figure) => {
            figure.hidden = matches.length > 0 && !matches.includes(figure);
          });
        }

        // Grey out sizes (and colors) that have no available variant with the other current selections
        updateAvailability() {
          const options = this.selectedOptions();
          this.querySelectorAll('[data-option-position]').forEach((fieldset, index) => {
            fieldset.querySelectorAll('[data-option-input]').forEach((input) => {
              const candidate = [...options];
              candidate[index] = input.value;
              const variant = this.findVariant(candidate);
              input.nextElementSibling?.classList.toggle('is-unavailable', !variant || !variant.available);
            });
          });
        }

        setButton(enabled, label) {
          this.addButton.disabled = !enabled;
          if (label) this.addLabel.textContent = label;
        }

        // The regular product button always adds only the selected variant and quantity.
        buildItems() {
          const id = Number(this.variantInput.value);
          const quantity = Math.max(1, parseInt(this.quantity.value, 10) || 1);
          return [{ id, quantity }];
        }

        // The table button adds only the valid sizes entered in the grid. It does not
        // change the selected variant, the regular quantity, or the regular button state.
        buildBulkItems() {
          const gridInputs = this.querySelectorAll('[data-grid-qty]');
          if (gridInputs.length) {
            return [...gridInputs].flatMap((input) => {
              if (input.dataset.gridCommitted === 'true') return [];
              const quantity = Math.max(0, parseInt(input.value, 10) || 0);
              if (quantity < 1 || input.disabled) return [];
              const variant = this.variants.find((item) => String(item.id) === input.dataset.variantId);
              if (!variant?.available) return [];
              const max = input.max === '' ? null : Number(input.max);
              const availableQuantity = max !== null && Number.isFinite(max) ? Math.min(quantity, max) : quantity;
              return availableQuantity > 0 ? [{ id: variant.id, quantity: availableQuantity }] : [];
            });
          }
          const sizePosition = Number(this.dataset.sizePosition);
          const items = [];
          if (!sizePosition) return items;

          const options = this.selectedOptions();
          this.querySelectorAll('[data-bulk-size]').forEach((input) => {
            const quantity = Number(input.value);
            if (!Number.isSafeInteger(quantity) || quantity < 1) return;

            const candidate = [...options];
            candidate[sizePosition - 1] = input.dataset.bulkSize;
            const variant = this.findVariant(candidate);
            if (variant?.available) {
              const limit = this.getVariantInventoryLimit(variant);
              items.push({ id: variant.id, quantity: limit === null ? quantity : Math.min(quantity, limit) });
            }
          });

          return items;
        }

        onGridQuantityChange(input) {
          delete input.dataset.gridCommitted;
          const quantity = parseInt(input.value, 10);
          if (!Number.isFinite(quantity) || quantity < 0) {
            input.value = '';
          } else if (input.max !== '' && quantity > Number(input.max)) {
            input.value = input.max;
          }
          input.closest('.product-showcase__bulk-cell')?.classList.toggle('is-added', Number(input.value) > 0);
          const display = input.closest('.product-showcase__bulk-cell')?.querySelector('[data-vbog-display]');
          if (display && !input.closest('.product-showcase__bulk-cell')?.classList.contains('vbog__cell--editing')) {
            display.textContent = input.value || display.dataset.inventory || '0';
          }
          this.updateGridTotals();
          this.updateBulkButtonState();
        }

        async loadGridQuantitiesFromCart() {
          const gridInputs = [...this.querySelectorAll('[data-grid-qty]')];
          if (!gridInputs.length) return;

          try {
            const cart = await fetch(`${window.Shopify?.routes?.root ?? '/'}cart.js`).then((response) => {
              if (!response.ok) throw new Error('Could not load cart');
              return response.json();
            });
            const quantitiesByVariant = new Map();

            cart.items
              .filter((item) => this.variants.some((variant) => String(variant.productId) === String(item.product_id)))
              .forEach((item) => {
                const variantId = String(item.variant_id);
                quantitiesByVariant.set(variantId, (quantitiesByVariant.get(variantId) || 0) + item.quantity);
              });

            gridInputs.forEach((input) => {
              const quantity = quantitiesByVariant.get(input.dataset.variantId);
              if (quantity === undefined || input.value !== '') return;
              input.value = String(quantity);
              const cell = input.closest('.product-showcase__bulk-cell');
              cell?.classList.toggle('is-added', quantity > 0);
              if (quantity > 0) {
                input.dataset.gridCommitted = 'true';
                cell?.classList.add('vbog__cell--editing');
              }
              const display = cell?.querySelector('[data-vbog-display]');
              if (display) display.textContent = quantity > 0 ? display.dataset.inventory || '0' : String(quantity);
            });

            this.updateGridTotals();
            this.updateBulkButtonState();
          } catch (error) {
            console.warn('Unable to preload product quantities from cart.', error);
          }
        }

        updateGridTotals() {
          this.querySelectorAll('[data-grid-total]').forEach((total) => {
            const selectedSize = total.dataset.gridTotal;
            const sum = [...this.querySelectorAll('[data-grid-qty]')]
              .filter((input) => input.dataset.gridSize === selectedSize)
              .reduce((quantity, input) => quantity + (parseInt(input.value, 10) || 0), 0);
            total.textContent = sum > 0 ? String(sum) : '—';
          });
        }

        getVariantInventoryLimit(variant) {
          if (!variant?.available || !variant.inventoryManagement) return null;
          const quantity = Number(variant.inventoryQuantity);
          return Number.isSafeInteger(quantity) && quantity > 0 ? quantity : null;
        }

        refreshBulkQuantities() {
          const sizePosition = Number(this.dataset.sizePosition);
          if (!sizePosition) return;

          const options = this.selectedOptions();
          this.querySelectorAll('[data-bulk-size]').forEach((input) => {
            const candidate = [...options];
            candidate[sizePosition - 1] = input.dataset.bulkSize;
            const variant = this.findVariant(candidate);
            const limit = this.getVariantInventoryLimit(variant);

            if (limit === null) {
              input.removeAttribute('max');
              return;
            }

            input.max = String(limit);
            const enteredQuantity = Number(input.value);
            if (input.value !== '' && Number.isFinite(enteredQuantity) && enteredQuantity > limit) {
              input.value = String(limit);
            }
          });
        }

        onBulkQuantityChange(input) {
          this.refreshBulkQuantities();
          const quantity = Number(input.value);
          if (input.value !== '' && (!Number.isSafeInteger(quantity) || quantity < 0)) {
            input.value = '';
          }
          this.updateBulkButtonState();
        }

        updateBulkButtonState() {
          if (!this.bulkAddButton) return;
          const items = this.buildBulkItems();
          const hasItems = items.length > 0;
          if (this.bulkActionBar) this.bulkActionBar.hidden = !hasItems;
          this.bulkAddButton.disabled = this.bulkRequestInProgress || !hasItems;
          if (this.bulkActionSummary) {
            const total = items.reduce((sum, item) => sum + item.quantity, 0);
            this.bulkActionSummary.textContent = total > 0 ? `${total} ${total === 1 ? 'ITEM' : 'ITEMS'} SELECTED` : '';
          }
        }

        syncBulkButtonWidth() {
          const table = this.querySelector('.product-showcase__bulk-table');
          if (!table || !this.bulkAddButton) return;
          const tableWidth = table.getBoundingClientRect().width;
          if (tableWidth > 0) this.bulkAddButton.style.width = `${tableWidth}px`;
        }

        async onBulkSubmit(event) {
          event?.preventDefault?.();
          if (!this.bulkAddButton || this.bulkRequestInProgress) return;

          const items = this.buildBulkItems();
          if (!items.length) return;

          const sections = [...document.querySelectorAll('cart-items-component')]
            .map((element) => element.dataset.sectionId)
            .filter(Boolean);
          const deferred = CartLinesUpdateEvent.createPromise();
          this.dispatchEvent(
            new CartLinesUpdateEvent({
              action: 'add',
              context: 'product',
              lines: items.map((item) => ({ merchandiseId: String(item.id), quantity: item.quantity })),
              promise: deferred.promise,
            })
          );

          this.bulkRequestInProgress = true;
          items.forEach(({ id }) => {
            const input = this.querySelector(`[data-grid-qty][data-variant-id="${id}"]`);
            const cell = input?.closest('.product-showcase__bulk-cell');
            if (!cell) return;
            cell.classList.add('vbog__cell--editing', 'is-added');
            const display = cell.querySelector('[data-vbog-display]');
            if (display) display.textContent = display.dataset.inventory || '0';
          });
          this.updateBulkButtonState();
          if (this.bulkMessage) this.bulkMessage.hidden = true;

          try {
            const response = await fetch(`${window.Shopify?.routes?.root ?? '/'}cart/add.js`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ items, sections: sections.join(',') }),
            }).then((res) => res.json());

            const partialAvailabilityMessage = response.description || response.message || '';
            const wasPartiallyAdded =
              response.status &&
              /only\s+\d+\s+items?\s+were\s+added\s+to\s+your\s+cart\s+due\s+to\s+availability/i.test(
                partialAvailabilityMessage
              );
            if (response.status && !wasPartiallyAdded) {
              throw new Error(partialAvailabilityMessage || 'Add to cart failed');
            }

            const cart = await fetch(`${window.Shopify?.routes?.root ?? '/'}cart.js`).then((res) => res.json());
            deferred.resolve({
              cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart),
              detail: {
                items: cart.items,
                source: 'product-showcase-bulk',
                sourceId: this.dataset.sectionId,
                itemCount: items.reduce((sum, item) => sum + item.quantity, 0),
                productId: this.dataset.productId,
                didError: false,
              },
            });

            const addedQuantities = new Map(items.map((item) => [String(item.id), item.quantity]));
            this.querySelectorAll('[data-bulk-size]').forEach((input) => {
              input.value = '';
            });
            this.querySelectorAll('[data-grid-qty]').forEach((input) => {
              const cell = input.closest('.product-showcase__bulk-cell');
              const quantity = addedQuantities.get(input.dataset.variantId);
              if (quantity !== undefined) {
                input.value = String(quantity);
                input.dataset.gridCommitted = 'true';
                cell?.classList.add('vbog__cell--editing', 'is-added');
                const display = cell?.querySelector('[data-vbog-display]');
                if (display) display.textContent = display.dataset.inventory || '0';
              } else if (input.dataset.gridCommitted === 'true') {
                cell?.classList.add('vbog__cell--editing', 'is-added');
                const display = cell?.querySelector('[data-vbog-display]');
                if (display) display.textContent = display.dataset.inventory || '0';
              } else {
                input.value = '';
                cell?.classList.remove('vbog__cell--editing', 'is-added');
              }
            });
            this.updateGridTotals();
            if (wasPartiallyAdded) {
              if (this.bulkMessage) {
                this.bulkMessage.textContent = partialAvailabilityMessage;
                this.bulkMessage.hidden = false;
              }
            } else if (this.bulkMessage) {
              this.bulkMessage.hidden = true;
            }
            if (this.bulkAddLabel && !wasPartiallyAdded) {
              this.bulkAddLabel.textContent = '{{ section.settings.added_label | escape }}';
              setTimeout(() => {
                if (this.bulkAddLabel) this.bulkAddLabel.textContent = this.bulkDefaultLabel;
              }, 2000);
            }
          } catch (error) {
            deferred.reject(error);
            this.dispatchEvent(new CartErrorEvent({ error: error.message, code: 'INVALID' }));
            if (this.bulkMessage) {
              this.bulkMessage.textContent = error.message;
              this.bulkMessage.hidden = false;
            }
          } finally {
            this.bulkRequestInProgress = false;
            this.updateBulkButtonState();
          }
        }

        async onSubmit(event) {
          event.preventDefault();
          if (this.addButton.disabled) return;

          const items = this.buildItems();
          const sections = [...document.querySelectorAll('cart-items-component')]
            .map((element) => element.dataset.sectionId)
            .filter(Boolean);

          const deferred = CartLinesUpdateEvent.createPromise();
          this.dispatchEvent(
            new CartLinesUpdateEvent({
              action: 'add',
              context: 'product',
              lines: items.map((item) => ({ merchandiseId: String(item.id), quantity: item.quantity })),
              promise: deferred.promise,
            })
          );

          this.addButton.disabled = true;
          this.message.hidden = true;

          try {
            const response = await fetch(`${window.Shopify?.routes?.root ?? '/'}cart/add.js`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ items, sections: sections.join(',') }),
            }).then((res) => res.json());

            if (response.status) throw new Error(response.description || response.message || 'Add to cart failed');

            const cart = await fetch(`${window.Shopify?.routes?.root ?? '/'}cart.js`).then((res) => res.json());
            deferred.resolve({
              cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart),
              detail: {
                items: cart.items,
                source: 'product-showcase',
                sourceId: this.dataset.sectionId,
                itemCount: items.reduce((sum, item) => sum + item.quantity, 0),
                productId: this.dataset.productId,
                sections: response.sections,
                didError: false,
              },
            });

            this.querySelectorAll('[data-bulk-size]').forEach((input) => (input.value = ''));
            this.addLabel.textContent = '{{ section.settings.added_label | escape }}';
            setTimeout(() => (this.addLabel.textContent = this.defaultLabel), 2000);
          } catch (error) {
            deferred.reject(error);
            this.dispatchEvent(new CartErrorEvent({ error: error.message, code: 'INVALID' }));
            this.message.textContent = error.message;
            this.message.hidden = false;
          } finally {
            const variant = this.variants.find((v) => v.id === Number(this.variantInput.value));
            this.addButton.disabled = !(variant && variant.available);
          }
        }
      }
    );
  }
</script>

