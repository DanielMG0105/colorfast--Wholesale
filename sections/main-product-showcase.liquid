  }

  .product-showcase__tiers {
    margin-top: 20px;

    td {
      width: 136px;
      height: 40px;
    }
  }

  .product-showcase__bulk {
    margin-top: 72px;
  }

  .product-showcase__bulk-wrap {
    width: fit-content;
    max-width: 100%;
  }

  .product-showcase__bulk-table {
    font-size: 16px;

    th,
    td {
      width: 62px;
      height: 40px;
      padding: 0;
    }

    input {
      width: 100%;
      height: 40px;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      text-align: center;
      -moz-appearance: textfield;
    }

    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
  }

  .product-showcase__hint {
    margin: 10px 0 0;
    font-size: 13px;
    opacity: 0.7;
  }

  .product-showcase__bulk-add {
    display: block;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    height: 56px;
    margin-top: 18px;
    font-size: 16px;
  }

  .product-showcase__bulk-grid {
    margin-top: 20px;
  }

  .product-showcase__bulk-grid > summary {
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    list-style: none;
    font-size: 17px;
    text-transform: none;
  }
  .product-showcase__bulk-grid > summary::-webkit-details-marker { display: none; }
  .product-showcase__bulk-grid .product-showcase__plus { display: inline-block; }
  .product-showcase__bulk-grid[open] .product-showcase__plus::after { transform: rotate(0deg); }
  .product-showcase__bulk-content { padding: 14px 0 0; font-size: 13px; }
  .product-showcase__bulk-grid .product-showcase__bulk-wrap { width: 100%; overflow-x: auto; }
  .product-showcase__bulk-grid .product-showcase__bulk-table { width: 100%; min-width: 520px; table-layout: fixed; border-collapse: separate; border-spacing: 10px; margin: -10px; font-size: 11px; }
  .product-showcase__bulk-grid .product-showcase__bulk-table th,
  .product-showcase__bulk-grid .product-showcase__bulk-table td { height: 48px; padding: 0 8px; border: 0; text-align: center; }
  .product-showcase__bulk-grid .product-showcase__bulk-table thead th,
  .product-showcase__bulk-grid .product-showcase__bulk-table tbody th,
  .product-showcase__bulk-grid .product-showcase__bulk-table tfoot th { border: 1px solid #111; background: transparent; font-size: 11px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; }
  .product-showcase__bulk-grid .product-showcase__bulk-table th:first-child { width: 140px; min-width: 140px; }
  .product-showcase__bulk-grid .product-showcase__bulk-table .product-showcase__bulk-color { background-color: #f0f0f0; color: #000; }
  .product-showcase__bulk-grid .product-showcase__bulk-table .product-showcase__bulk-color.is-dark { color: #fff; }
  .product-showcase__bulk-grid .product-showcase__bulk-table td.product-showcase__bulk-cell { position: relative; height: 54px; padding: 0; background: #f0f0f0; cursor: pointer; }
  .product-showcase__bulk-grid .product-showcase__bulk-cell > span { position: absolute; right: 7px; bottom: 6px; z-index: 1; font-size: 10px; line-height: 1; opacity: .85; pointer-events: none; }
  .product-showcase__bulk-grid .product-showcase__bulk-cell input { position: absolute; inset: 0; display: block; box-sizing: border-box; width: 100%; height: 100%; margin: 0; padding: 0 20px 0 4px; border: 0 !important; border-radius: 0 !important; outline: none !important; box-shadow: none !important; appearance: none; background: transparent; color: inherit; font: inherit; text-align: right; opacity: 0; cursor: pointer; }
  .product-showcase__bulk-grid .product-showcase__bulk-cell.is-editing > span { display: none; }
  .product-showcase__bulk-grid .product-showcase__bulk-cell.is-editing input { opacity: 1; cursor: text; }
  .product-showcase__bulk-grid .product-showcase__bulk-cell.is-selected { background: #dedede; }
  .product-showcase__bulk-grid .product-showcase__bulk-cell.is-unavailable { opacity: .35; cursor: not-allowed; }
  .product-showcase__bulk-grid .product-showcase__bulk-table tfoot tr { position: relative; }
  .product-showcase__bulk-grid .product-showcase__bulk-table tfoot tr::before { content: ''; position: absolute; top: -5px; left: 0; right: 0; height: 1px; background: var(--ps-border); }
  .product-showcase__bulk-grid .product-showcase__bulk-table tfoot td { background: #f0f0f0; text-align: right; }
  .product-showcase__bulk-grid .product-showcase__bulk-add { width: 100%; }
  .product-showcase__bulk-grid .product-showcase__bulk-add[hidden] { display: none !important; }
  .product-showcase__bulk-grid .vbog__scroll-wrapper { width: 100%; overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch; scrollbar-width: thin; }
  .product-showcase__bulk-grid .vbog__table-clip { min-width: 100%; }
  .product-showcase__bulk-grid .vbog__table { width: 100%; min-width: var(--vbog-table-min-width, 520px); margin: 0; border-collapse: separate; border-spacing: 10px; table-layout: fixed; background: transparent; }
  .product-showcase__bulk-grid .vbog__cell { position: relative; height: 48px; padding: 0 4px; border: 0; background: transparent; font-size: 11px; letter-spacing: .04em; text-align: center; vertical-align: middle; white-space: nowrap; }
  .product-showcase__bulk-grid .vbog__cell--label,
  .product-showcase__bulk-grid .vbog__cell--total-label,
  .product-showcase__bulk-grid .vbog__cell--swatch,
  .product-showcase__bulk-grid .vbog__cell--size-header { border: 1px solid var(--ps-border); background: var(--ps-bg); }
  .product-showcase__bulk-grid .vbog__cell--label,
  .product-showcase__bulk-grid .vbog__cell--total-label,
  .product-showcase__bulk-grid .vbog__cell--swatch { width: 140px; min-width: 140px; max-width: 140px; }
  .product-showcase__bulk-grid .vbog__cell--label,
  .product-showcase__bulk-grid .vbog__cell--size-header,
  .product-showcase__bulk-grid .vbog__cell--total-label { font-size: 12px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .product-showcase__bulk-grid .vbog__cell--size-header { min-width: 60px; }
  .product-showcase__bulk-grid .vbog__cell--swatch { padding: 0; overflow: hidden; }
  .product-showcase__bulk-grid .vbog__swatch { display: flex; width: 100%; height: 52px; align-items: center; justify-content: center; background-size: cover; background-position: center; background-repeat: no-repeat; }
  .product-showcase__bulk-grid .vbog__swatch-name { padding: 0 6px; color: #000; font-size: 10px; font-weight: 600; letter-spacing: .06em; text-shadow: 0 1px 2px rgb(255 255 255 / 35%); }
  .product-showcase__bulk-grid .vbog__swatch--dark .vbog__swatch-name { color: #fff; text-shadow: 0 1px 2px rgb(0 0 0 / 35%); }
  .product-showcase__bulk-grid .vbog__cell--variant { min-width: 60px; padding: 0 6px 6px; background: #f0f0f0; text-align: right; vertical-align: bottom; cursor: pointer; user-select: none; }
  .product-showcase__bulk-grid .vbog__cell--variant:hover:not(.vbog__cell--disabled) { background: #e5e5e5; }
  .product-showcase__bulk-grid .vbog__cell-inventory { display: block; line-height: 1; transition: opacity .15s ease; }
  .product-showcase__bulk-grid .vbog__cell-qty-input { display: none !important; width: 100%; height: 100%; padding: 0; border: 0 !important; border-radius: 0 !important; outline: none !important; box-shadow: none !important; background: transparent !important; color: inherit; font: inherit; text-align: center; appearance: none; -moz-appearance: textfield; }
  .product-showcase__bulk-grid .vbog__cell-qty-input::-webkit-outer-spin-button,
  .product-showcase__bulk-grid .vbog__cell-qty-input::-webkit-inner-spin-button { margin: 0; -webkit-appearance: none; }
  .product-showcase__bulk-grid .vbog__cell--editing .vbog__cell-inventory { display: none; }
  .product-showcase__bulk-grid .vbog__cell--editing .vbog__cell-qty-input { display: block !important; }
  .product-showcase__bulk-grid .vbog__cell--variant.is-added { background: var(--ps-text); color: var(--ps-bg); }
  .product-showcase__bulk-grid .vbog__cell--disabled { cursor: not-allowed; opacity: .28; }
  .product-showcase__bulk-grid .vbog__cell--empty { opacity: .18; pointer-events: none; }
  .product-showcase__bulk-grid .vbog__row--total .vbog__cell { height: 48px; font-size: 12px; font-weight: 500; letter-spacing: .1em; }
  .product-showcase__bulk-grid .vbog__cell--total-value { background: #f0f0f0; text-align: right; vertical-align: bottom; padding: 0 6px 6px; }
  .product-showcase__bulk-grid .vbog__total-divider td { height: 1px; padding: 0; border: 0; background: var(--ps-border); }

  /* Mobile: compact product info */
  @media screen and (max-width: 749px) {
    .product-showcase__grid {
      gap: 28px;
    }

    .product-showcase__media {
      gap: 16px;
    }

    .product-showcase__title {
      font-size: calc(var(--ps-title-size) * 0.55);
      line-height: 1.2;
    }

    .product-showcase__price {
      margin-top: 12px;
      font-size: 19px;
    }

    .product-showcase__description {
      margin-top: 16px;
      font-size: 15px;
      line-height: 1.4;
    }

    .product-showcase__option {
      margin-top: 20px;
    }

    .product-showcase__option + .product-showcase__option {
      margin-top: 24px;
    }

    .product-showcase__label {
      margin-bottom: 10px;
      font-size: 14px;
    }

    .product-showcase__values {
      gap: 8px;
    }

    .product-showcase__values--swatches {
      gap: 10px;
    }

    .product-showcase__swatch {
      width: 22px;
      height: 22px;
    }

    .product-showcase__pill {
      min-width: 42px;
      height: 40px;
      padding: 0 10px;
      font-size: 14px;
    }

    .product-showcase__buy {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 10px;
      margin-top: 28px;
    }

    .product-showcase__quantity {
      height: 48px;
      padding: 0 6px;
    }

    .product-showcase__step {
      width: 36px;
      height: 36px;

      svg {
        width: 16px;
        height: 16px;
      }
    }

    .product-showcase .product-showcase__qty-input {
      width: 40px;
      font-size: 16px;
    }

    .product-showcase__add {
      height: 48px;
      font-size: 14px;
    }

    .product-showcase__accordions {
      gap: 18px;
      margin-top: 18px;
    }

    .product-showcase__accordion summary {
      font-size: 15px;
    }

    .product-showcase__plus {
      width: 12px;
      height: 12px;
    }

    .product-showcase__accordion-body {
      padding: 10px 0 0 26px;
      font-size: 14px;
    }

    .product-showcase__wholesale {
      margin-top: 44px;

      summary {
        font-size: 17px;
      }
    }

    .product-showcase__circle-plus {
      width: 18px;
      height: 18px;

      &::before,
      &::after {
        width: 8px;
      }
    }

    .product-showcase__table {
      font-size: 14px;
    }

    .product-showcase__tiers {
      margin-top: 14px;

      td {
        width: 110px;
        height: 34px;
      }
    }

    .product-showcase__bulk {
      margin-top: 36px;
    }

    .product-showcase__bulk-wrap {
      width: 100%;
    }

    .product-showcase__bulk-table {
      width: 100%;
      table-layout: fixed;
      font-size: 13px;

      th,
      td {
        width: auto;
        height: 34px;
      }

      input {
        height: 34px;
        font-size: 16px;
      }
    }

    .product-showcase__bulk-add {
      height: 48px;
      margin-top: 14px;
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product showcase",
  "tag": "section",
  "class": "section-main-product-showcase",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "blocks": [
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Product Details"
        },
        {
          "type": "checkbox",
          "id": "use_description",
          "label": "Show product description",
          "default": false
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from page",
          "info": "Overrides the content above."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Purchase"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Added label",
      "default": "Added"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "color_option_names",
      "label": "Color option names",
      "info": "Comma-separated option names shown as swatches.",
      "default": "Color,Colour"
    },
    {
      "type": "page",
      "id": "dye_page",
      "label": "Custom dye page",
      "info": "Products with the custom.custom_dye metafield set to true show a dye swatch next to their colors that opens this page with the product loaded. Defaults to /pages/custom-dye."
    },
    {
      "type": "text",
      "id": "dye_label",
      "label": "Custom dye swatch label",
      "default": "Custom dye"
    },
    {
      "type": "header",
      "content": "Wholesale pricing"
    },
    {
      "type": "checkbox",
      "id": "show_wholesale",
      "label": "Show wholesale pricing",
      "default": true
    },
    {
      "type": "text",
      "id": "wholesale_heading",
      "label": "Heading",
      "default": "Wholesale pricing"
    },
    {
      "type": "textarea",
      "id": "wholesale_tiers",
      "label": "Default tiers",
      "info": "One tier per line as quantity: price. A product metafield custom.wholesale_tiers (multi-line text) overrides this.",
      "default": "1-99: 24.49\n100-299: 23.27\n300-999: 22.10\n1000+: 21.00"
    },
    {
      "type": "header",
      "content": "Size grid"
    },
    {
      "type": "checkbox",
      "id": "show_bulk_grid",
      "label": "Show size quantity grid",
      "info": "Display the color and size bulk order grid below the Add to Cart button.",
      "default": true
    },
    {
      "type": "text",
      "id": "bulk_heading",
      "label": "Grid heading"
    },
    {
      "type": "text",
      "id": "bulk_hint",
      "label": "Grid hint"
    },
    {
      "type": "text",
      "id": "bulk_add_label",
      "label": "Grid add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Title font",
      "default": "montserrat_n6"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "montserrat_n4"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 20,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 42
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Media column width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 43
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between image and info",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 17
    },
    {
      "type": "range",
      "id": "side_margin",
      "label": "Left margin (desktop)",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 172
    },
    {
      "type": "range",
      "id": "side_margin_right",
      "label": "Right margin (desktop)",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#c8c8c7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#4d4d4d"
    }
  ]
}
{% endschema %}
