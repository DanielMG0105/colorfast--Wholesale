{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign current_variant = product.selected_or_first_available_variant
  assign color_option_names = section.settings.color_option_names | downcase | split: ','

  assign color_option_position = 0
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    for accepted in color_option_names
      assign accepted_name = accepted | strip
      if option_name == accepted_name
        assign color_option_position = option.position
        break
      endif
    endfor
    if color_option_position > 0
      break
    endif
  endfor

  assign size_option_position = 0
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    if option_name == 'size' or option_name == 'talla'
      assign size_option_position = option.position
      break
    endif
  endfor

  assign tiers_source = product.metafields.custom.wholesale_tiers.value | default: section.settings.wholesale_tiers
  assign tier_lines = tiers_source | newline_to_br | split: '<br />'

  assign form_id = 'ProductShowcaseForm-' | append: section.id
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
</style>

<product-showcase
  class="product-showcase"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-color-position="{{ color_option_position }}"
  data-size-position="{{ size_option_position }}"
  style="
    --ps-bg: {{ section.settings.background_color }};
    --ps-text: {{ section.settings.text_color }};
    --ps-border: {{ section.settings.border_color }};
    --ps-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --ps-heading-weight: {{ heading_font.weight }};
    --ps-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --ps-body-weight: {{ body_font.weight }};
    --ps-title-size: {{ section.settings.title_size }}px;
    --ps-media-width: {{ section.settings.media_width }}%;
    --ps-margin: {{ section.settings.side_margin }}px;
    --ps-margin-right: {{ section.settings.side_margin_right }}px;
    --ps-gap: {{ section.settings.column_gap }}%;
    --ps-pt: {{ section.settings.padding_top }}px;
    --ps-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="product-showcase__grid">
    <div class="product-showcase__media" data-media-list>
      {%- for media in product.media -%}
        <figure class="product-showcase__figure" data-media-id="{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- assign media_alt = media.alt | default: product.title | escape -%}
              {{
                media
                | image_url: width: 2000
                | image_tag:
                  widths: '600, 900, 1200, 1600, 2000',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: media_alt,
                  class: 'product-showcase__image'
              }}
            {%- when 'video' -%}
              {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'product-showcase__image' }}
            {%- else -%}
              {{ media | media_tag: class: 'product-showcase__image' }}
          {%- endcase -%}
        </figure>
      {%- else -%}
        <figure class="product-showcase__figure">
          {{ 'product-apparel-1' | placeholder_svg_tag: 'product-showcase__image product-showcase__placeholder' }}
        </figure>
      {%- endfor -%}
    </div>

    <div class="product-showcase__info">
      <div class="product-showcase__sticky">
        <h1 class="product-showcase__title">{{ product.title | escape }}</h1>

        <p class="product-showcase__price" data-price>
          {{- current_variant.price | money_with_currency -}}
        </p>

        {%- if product.description != blank -%}
          <div class="product-showcase__description rte">{{ product.description }}</div>
        {%- endif -%}

        {%- form 'product', product, id: form_id, class: 'product-showcase__form', novalidate: 'novalidate', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="product-showcase__option" data-option-position="{{ option.position }}">
                <legend class="product-showcase__label">
                  {{ option.name | escape }}: <span data-option-value>{{ option.selected_value | escape }}</span>
                </legend>

                <div class="product-showcase__values{% if option.position == color_option_position %} product-showcase__values--swatches{% endif %}">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign input_id = form_id | append: '-' | append: option.position | append: '-' | append: forloop.index
                      assign is_color = false
                      if option.position == color_option_position
                        assign is_color = true
                        assign swatch_color = value.swatch.color | default: value
                        assign is_light = false
                        if value.swatch.color
                          assign brightness = value.swatch.color | color_brightness
                          if brightness > 200
                            assign is_light = true
                          endif
                        else
                          assign value_handle = value | handle
                          if value_handle contains 'white' or value_handle contains 'natural' or value_handle contains 'cream' or value_handle contains 'ivory' or value_handle contains 'pfd'
                            assign is_light = true
                          endif
                        endif
                      endif
                    -%}
                    <input
                      type="radio"
                      class="product-showcase__radio"
                      id="{{ input_id }}"
                      name="option{{ option.position }}"
                      value="{{ value | escape }}"
                      data-option-input
                      {% if value.selected %}
                        checked
                      {% endif %}
                    >
                    {%- if is_color -%}
                      <label
                        for="{{ input_id }}"
                        class="product-showcase__swatch{% if is_light %} product-showcase__swatch--light{% endif %}"
                        style="{% if value.swatch.image %}background-image: url({{ value.swatch.image | image_url: width: 72 }});{% else %}background-color: {{ swatch_color }};{% endif %}"
                        title="{{ value | escape }}"
                      >
                        <span class="visually-hidden">{{ value | escape }}</span>
                      </label>
                    {%- else -%}
                      <label for="{{ input_id }}" class="product-showcase__pill">{{ value | escape }}</label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          <div class="product-showcase__buy">
            <div class="product-showcase__quantity">
              <button type="button" class="product-showcase__step" data-step="-1" aria-label="Decrease quantity">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>
              </button>
              <input
                class="product-showcase__qty-input"
                type="number"
                name="quantity"
                value="1"
                min="1"
                inputmode="numeric"
                aria-label="Quantity"
                data-quantity
              >
              <button type="button" class="product-showcase__step" data-step="1" aria-label="Increase quantity">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8 3v10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>
              </button>
            </div>

            <button
              type="submit"
              class="product-showcase__add"
              data-add-button
              {% unless current_variant.available %}
                disabled
              {% endunless %}
            >
              <span data-add-label>
                {%- if current_variant.available -%}
                  {{ section.settings.add_label | escape }}
                {%- else -%}
                  {{ section.settings.sold_out_label | escape }}
                {%- endif -%}
              </span>
            </button>
          </div>

          <p class="product-showcase__message" role="status" data-message hidden></p>
        {%- endform -%}

        {%- if section.blocks.size > 0 -%}
          <div class="product-showcase__accordions">
            {%- for block in section.blocks -%}
              {%- liquid
                assign block_content = block.settings.content
                if block.settings.page != blank
                  assign block_content = block.settings.page.content
                endif
                if block.settings.use_description
                  assign block_content = product.description
                endif
              -%}
              <details class="product-showcase__accordion" {{ block.shopify_attributes }}>
                <summary>
                  <span class="product-showcase__plus" aria-hidden="true"></span>
                  {{ block.settings.heading | escape }}
                </summary>
                <div class="product-showcase__accordion-body rte">{{ block_content }}</div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_wholesale and tiers_source != blank -%}
          <details class="product-showcase__wholesale" open>
            <summary>
              {{ section.settings.wholesale_heading | escape }}
              <span class="product-showcase__circle-plus" aria-hidden="true"></span>
            </summary>
            <table class="product-showcase__table product-showcase__tiers">
              <tbody>
                {%- for line in tier_lines -%}
                  {%- assign parts = line | strip | split: ':' -%}
                  {%- if parts.size > 1 -%}
                    {%- assign tier_price = parts[1] | strip | remove: '$' | times: 100 -%}
                    <tr>
                      <td>{{ parts[0] | strip | escape }}</td>
                      <td>{{ tier_price | money }}</td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          </details>
        {%- endif -%}

        {%- if section.settings.show_bulk_grid and size_option_position > 0 -%}
          {%- assign size_index = size_option_position | minus: 1 -%}
          {%- assign size_option = product.options_with_values[size_index] -%}
          <div class="product-showcase__bulk">
            {%- if section.settings.bulk_heading != blank -%}
              <p class="product-showcase__label">{{ section.settings.bulk_heading | escape }}</p>
            {%- endif -%}
            <table class="product-showcase__table product-showcase__bulk-table">
              <thead>
                <tr>
                  {%- for value in size_option.values -%}
                    <th scope="col">{{ value | escape }}</th>
                  {%- endfor -%}
                </tr>
              </thead>
              <tbody>
                <tr>
                  {%- for value in size_option.values -%}
                    <td>
                      <input
                        type="number"
                        min="0"
                        inputmode="numeric"
                        placeholder=""
                        aria-label="{{ value | escape }} quantity"
                        data-bulk-size="{{ value | escape }}"
                      >
                    </td>
                  {%- endfor -%}
                </tr>
              </tbody>
            </table>
            {%- if section.settings.bulk_hint != blank -%}
              <p class="product-showcase__hint">{{ section.settings.bulk_hint | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money_with_currency | json }},
          "mediaId": {{ variant.featured_media.id | default: 0 }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</product-showcase>

<script type="module">
  import { CartLinesUpdateEvent, CartErrorEvent } from '@shopify/events';

  if (!customElements.get('product-showcase')) {
    customElements.define(
      'product-showcase',
      class ProductShowcase extends HTMLElement {
        connectedCallback() {
          this.variants = JSON.parse(this.querySelector('[data-variants]').textContent);
          this.form = this.querySelector('[data-product-form]');
          this.variantInput = this.querySelector('[data-variant-input]');
          this.quantity = this.querySelector('[data-quantity]');
          this.addButton = this.querySelector('[data-add-button]');
          this.addLabel = this.querySelector('[data-add-label]');
          this.message = this.querySelector('[data-message]');
          this.defaultLabel = this.addLabel?.textContent.trim();

          this.querySelectorAll('[data-option-input]').forEach((input) =>
            input.addEventListener('change', () => this.onOptionChange())
          );
          this.querySelectorAll('[data-step]').forEach((button) =>
            button.addEventListener('click', () => {
              const next = Math.max(1, (parseInt(this.quantity.value, 10) || 1) + Number(button.dataset.step));
              this.quantity.value = String(next);
            })
          );
          this.form?.addEventListener('submit', (event) => this.onSubmit(event));
          this.updateAvailability();
        }

        selectedOptions() {
          return [...this.querySelectorAll('[data-option-position]')].map(
            (fieldset) => fieldset.querySelector('[data-option-input]:checked')?.value
          );
        }

        findVariant(options) {
          return this.variants.find((variant) => variant.options.every((value, i) => value === options[i]));
        }

        onOptionChange() {
          const options = this.selectedOptions();
          this.querySelectorAll('[data-option-position]').forEach((fieldset, i) => {
            const label = fieldset.querySelector('[data-option-value]');
            if (label) label.textContent = options[i] ?? '';
          });

          const variant = this.findVariant(options);
          if (!variant) {
            this.setButton(false, this.defaultLabel);
            return;
          }

          this.variantInput.value = String(variant.id);
          this.querySelector('[data-price]').textContent = variant.price;
          this.setButton(variant.available, variant.available ? this.defaultLabel : '{{ section.settings.sold_out_label | escape }}');

          if (variant.mediaId) {
            const figure = this.querySelector(`[data-media-id="${variant.mediaId}"]`);
            const list = this.querySelector('[data-media-list]');
            if (figure && list && list.firstElementChild !== figure) list.prepend(figure);
          }

          const url = new URL(window.location.href);
          url.searchParams.set('variant', String(variant.id));
          window.history.replaceState({}, '', url.toString());
          this.updateAvailability();
        }

        // Grey out sizes (and colors) that have no available variant with the other current selections
        updateAvailability() {
          const options = this.selectedOptions();
          this.querySelectorAll('[data-option-position]').forEach((fieldset, index) => {
            fieldset.querySelectorAll('[data-option-input]').forEach((input) => {
              const candidate = [...options];
              candidate[index] = input.value;
              const variant = this.findVariant(candidate);
              input.nextElementSibling?.classList.toggle('is-unavailable', !variant || !variant.available);
            });
          });
        }

        setButton(enabled, label) {
          this.addButton.disabled = !enabled;
          if (label) this.addLabel.textContent = label;
        }

        // Size grid quantities for the selected color; falls back to the single selected variant
        buildItems() {
          const sizePosition = Number(this.dataset.sizePosition);
          const items = [];
          if (sizePosition > 0) {
            const options = this.selectedOptions();
            this.querySelectorAll('[data-bulk-size]').forEach((input) => {
              const quantity = parseInt(input.value, 10);
              if (!quantity || quantity < 1) return;
              const candidate = [...options];
              candidate[sizePosition - 1] = input.dataset.bulkSize;
              const variant = this.findVariant(candidate);
              if (variant && variant.available) items.push({ id: variant.id, quantity });
            });
          }
          if (items.length) return items;
          return [{ id: Number(this.variantInput.value), quantity: Math.max(1, parseInt(this.quantity.value, 10) || 1) }];
        }

        async onSubmit(event) {
          event.preventDefault();
          if (this.addButton.disabled) return;

          const items = this.buildItems();
          const sections = [...document.querySelectorAll('cart-items-component')]
            .map((element) => element.dataset.sectionId)
            .filter(Boolean);

          const deferred = CartLinesUpdateEvent.createPromise();
          this.dispatchEvent(
            new CartLinesUpdateEvent({
              action: 'add',
              context: 'product',
              lines: items.map((item) => ({ merchandiseId: String(item.id), quantity: item.quantity })),
              promise: deferred.promise,
            })
          );

          this.addButton.disabled = true;
          this.message.hidden = true;

          try {
            const response = await fetch(`${window.Shopify?.routes?.root ?? '/'}cart/add.js`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ items, sections: sections.join(',') }),
            }).then((res) => res.json());

            if (response.status) throw new Error(response.description || response.message || 'Add to cart failed');

            const cart = await fetch(`${window.Shopify?.routes?.root ?? '/'}cart.js`).then((res) => res.json());
            deferred.resolve({
              cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart),
              detail: {
                items: cart.items,
                source: 'product-showcase',
                sourceId: this.dataset.sectionId,
                itemCount: items.reduce((sum, item) => sum + item.quantity, 0),
                productId: this.dataset.productId,
                sections: response.sections,
                didError: false,
              },
            });

            this.querySelectorAll('[data-bulk-size]').forEach((input) => (input.value = ''));
            this.addLabel.textContent = '{{ section.settings.added_label | escape }}';
            setTimeout(() => (this.addLabel.textContent = this.defaultLabel), 2000);
          } catch (error) {
            deferred.reject(error);
            this.dispatchEvent(new CartErrorEvent({ error: error.message, code: 'INVALID' }));
            this.message.textContent = error.message;
            this.message.hidden = false;
          } finally {
            const variant = this.variants.find((v) => v.id === Number(this.variantInput.value));
            this.addButton.disabled = !(variant && variant.available);
          }
        }
      }
    );
  }
</script>

{% stylesheet %}
  .product-showcase {
    display: block;
    background-color: var(--ps-bg);
    color: var(--ps-text);
    font-family: var(--ps-body-family);
    font-weight: var(--ps-body-weight);
    padding: calc(var(--ps-pt) * 0.5) 16px var(--ps-pb);

    @media screen and (min-width: 990px) {
      padding: var(--ps-pt) var(--ps-margin-right) var(--ps-pb) var(--ps-margin);
    }
  }

  /* First section under a transparent header: start below it */
  body:has(#header-component[transparent]) .content-for-layout > .shopify-section:first-child .product-showcase {
    padding-top: calc(var(--ps-pt) * 0.5 + var(--header-group-height, 0px));

    @media screen and (min-width: 990px) {
      padding-top: calc(var(--ps-pt) + var(--header-group-height, 0px));
    }
  }

  .product-showcase__grid {
    display: grid;
    gap: 40px;

    @media screen and (min-width: 990px) {
      grid-template-columns: var(--ps-media-width) minmax(0, 1fr);
      column-gap: var(--ps-gap);
      align-items: start;
    }
  }

  .product-showcase__media {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .product-showcase__figure {
    margin: 0;
  }

  .product-showcase__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .product-showcase__placeholder {
    aspect-ratio: 1;
    fill: currentColor;
    opacity: 0.25;
  }

  .product-showcase__sticky {
    display: flex;
    flex-direction: column;

    @media screen and (min-width: 990px) {
      position: sticky;
      top: calc(var(--header-height, 80px) + 24px);
    }
  }

  .product-showcase__title {
    margin: 0;
    font-family: var(--ps-heading-family);
    font-weight: var(--ps-heading-weight);
    font-size: calc(var(--ps-title-size) * 0.8);
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: inherit;

    @media screen and (min-width: 750px) {
      font-size: var(--ps-title-size);
    }
  }

  .product-showcase__price {
    margin: 22px 0 0;
    font-size: 27px;
    line-height: 1.1;
  }

  .product-showcase__description {
    margin-top: 24px;
    font-size: 19px;
    line-height: 1.2;
    max-width: 520px;

    p {
      margin: 0 0 1.2em;
    }
  }

  .product-showcase__option {
    margin: 24px 0 0;
    padding: 0;
    border: 0;
  }

  .product-showcase__option + .product-showcase__option {
    margin-top: 52px;
  }

  .product-showcase__label {
    margin: 0 0 20px;
    padding: 0;
    font-size: 19px;
  }

  .product-showcase__values {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
  }

  .product-showcase__values--swatches {
    gap: 12px;
  }

  .product-showcase__swatch {
    display: block;
    width: 26px;
    height: 26px;
    border: 1px solid var(--ps-text);
    background-size: cover;
    cursor: pointer;
  }

  .product-showcase__swatch--light {
    box-shadow: inset 0 0 0 2px var(--ps-bg);
  }

  /* Hide the native radios. The theme styles every input[type='radio'] (size, position, checked dot),
     which overrode .visually-hidden and made the checked one show up and take space. */
  .product-showcase .product-showcase__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    border: 0;
    opacity: 0;
    overflow: hidden;
    clip-path: inset(50%);
    appearance: none;
    pointer-events: none;
  }

  .product-showcase .product-showcase__radio::before,
  .product-showcase .product-showcase__radio::after {
    content: none;
    display: none;
  }

  .product-showcase__values {
    position: relative;
  }

  [data-option-input]:checked + .product-showcase__swatch {
    outline: 1px solid var(--ps-text);
    outline-offset: 3px;
  }

  .product-showcase__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 61px;
    height: 61px;
    padding: 0 12px;
    border: 1px solid var(--ps-border);
    font-size: 19px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  [data-option-input]:checked + .product-showcase__pill {
    background-color: var(--ps-text);
    border-color: var(--ps-text);
    color: var(--ps-bg);
  }

  .product-showcase__pill.is-unavailable,
  .product-showcase__swatch.is-unavailable {
    opacity: 0.35;
  }

  [data-option-input]:focus-visible + label {
    outline: 2px solid var(--ps-text);
    outline-offset: 3px;
  }

  .product-showcase__buy {
    display: grid;
    grid-template-columns: minmax(0, 268fr) minmax(0, 345fr);
    gap: 29px;
    margin-top: 72px;
  }

  .product-showcase__quantity {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 95px;
    padding: 0 28px;
    border: 1px solid var(--ps-border);
  }

  .product-showcase__step {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;

    svg {
      width: 22px;
      height: 22px;
    }
  }

  .product-showcase .product-showcase__qty-input {
    width: 60px;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 19px;
    text-align: center;
    -moz-appearance: textfield;
  }

  .product-showcase__qty-input::-webkit-outer-spin-button,
  .product-showcase__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .product-showcase__add {
    height: 95px;
    border: 1px solid var(--ps-border);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 19px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .product-showcase__add:hover:not([disabled]) {
    background-color: var(--ps-text);
    color: var(--ps-bg);
  }

  .product-showcase__add[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .product-showcase__message {
    margin: 12px 0 0;
    font-size: 14px;
  }

  .product-showcase__accordions {
    display: flex;
    flex-direction: column;
    gap: 30px;
    margin-top: 150px;
  }

  .product-showcase__accordion summary,
  .product-showcase__wholesale summary {
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    list-style: none;
  }

  .product-showcase__accordion summary::-webkit-details-marker,
  .product-showcase__wholesale summary::-webkit-details-marker {
    display: none;
  }

  .product-showcase__accordion summary {
    font-size: 17px;
  }

  .product-showcase__plus {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;

    &::before,
    &::after {
      content: '';
      position: absolute;
      inset: 50% 0 auto;
      height: 2px;
      margin-top: -1px;
      background: currentColor;
      transition: transform 0.2s ease;
    }

    &::after {
      transform: rotate(90deg);
    }
  }

  .product-showcase__accordion[open] .product-showcase__plus::after {
    transform: rotate(0deg);
  }

  .product-showcase__accordion-body {
    padding: 16px 0 0 30px;
    font-size: 15px;
    line-height: 1.45;
  }

  .product-showcase__wholesale {
    margin-top: 110px;

    summary {
      font-size: 24px;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }
  }

  .product-showcase__circle-plus {
    position: relative;
    width: 22px;
    height: 22px;
    border: 1.5px solid currentColor;
    border-radius: 50%;

    &::before,
    &::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 10px;
      height: 1.5px;
      background: currentColor;
      transform: translate(-50%, -50%);
    }

    &::after {
      transform: translate(-50%, -50%) rotate(90deg);
      transition: opacity 0.2s ease;
    }
  }

  .product-showcase__wholesale[open] .product-showcase__circle-plus::after {
    opacity: 0;
  }

  .product-showcase__table {
    border-collapse: collapse;
    font-size: 18px;

    td,
    th {
      border: 1px solid var(--ps-border);
      text-align: center;
      font-weight: inherit;
    }
  }

  .product-showcase__tiers {
    margin-top: 20px;

    td {
      width: 136px;
      height: 40px;
    }
  }

  .product-showcase__bulk {
    margin-top: 72px;
  }

  .product-showcase__bulk-table {
    font-size: 16px;

    th,
    td {
      width: 62px;
      height: 40px;
      padding: 0;
    }

    input {
      width: 100%;
      height: 40px;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      text-align: center;
      -moz-appearance: textfield;
    }

    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
  }

  .product-showcase__hint {
    margin: 10px 0 0;
    font-size: 13px;
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product showcase",
  "tag": "section",
  "class": "section-main-product-showcase",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "blocks": [
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Product Details"
        },
        {
          "type": "checkbox",
          "id": "use_description",
          "label": "Show product description",
          "default": false
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from page",
          "info": "Overrides the content above."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Purchase"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Added label",
      "default": "Added"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "color_option_names",
      "label": "Color option names",
      "info": "Comma-separated option names shown as swatches.",
      "default": "Color,Colour"
    },
    {
      "type": "header",
      "content": "Wholesale pricing"
    },
    {
      "type": "checkbox",
      "id": "show_wholesale",
      "label": "Show wholesale pricing",
      "default": true
    },
    {
      "type": "text",
      "id": "wholesale_heading",
      "label": "Heading",
      "default": "Wholesale pricing"
    },
    {
      "type": "textarea",
      "id": "wholesale_tiers",
      "label": "Default tiers",
