      "default": true
    },
    {
      "type": "text",
      "id": "bulk_heading",
      "label": "Grid heading"
    },
    {
      "type": "text",
      "id": "bulk_hint",
      "label": "Grid hint"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Title font",
      "default": "figtree_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "figtree_n5"
    },
    {
      "type": "range",
