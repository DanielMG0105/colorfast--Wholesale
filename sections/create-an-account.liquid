
  <div class="create-account-redirect">
    <div class="top--image">
      <img width="" height="" src="https://cdn.shopify.com/s/files/1/0664/1369/1100/files/createaccount.jpg?v=1752175540" alt="">
    </div>
    <div class="wrapper-buttons">
       <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {{ page.title | escape }}
      </h1>        
      <a href="/account/register"><span>NORMAL ACCOUNT</span></a>
      <a href="/pages/create-wholesale-account"><span>APPLY FOR WHOLESALE</span></a>
    </div>
  </div>

{% style %}
  #shopify-section-{{ section.id }}{
    height:100%;
  }
  .create-account-redirect{
    text-align:center;
    width:100%;     
    margin:auto;
    display:flex;
    align-items: center;
    height: 100%;
  }
  .create-account-redirect > .wrapper-buttons > h1{
    margin-bottom: 15px;
    font-size: 30px;
    letter-spacing: 0;
  }
  .create-account-redirect > .top--image{
     flex-basis: 40%;
  }
    
  .create-account-redirect > .top--image > img{
    width:90%;
  }
  .create-account-redirect > .wrapper-buttons{
    padding: 60px 20px;
    padding-top: 0;
    margin-top: -70px;
  }
  .create-account-redirect > .wrapper-buttons > a{
    display:block;
    width:auto;
    max-width:300px;
    flex-basis: 50%;
    background: #000;
    color: #fff;
    border:1px solid #000;
    padding: 0 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    margin: 0 30px 0 0;
    text-transform: uppercase;
    height: 55px;
    border-radius: 30px;
    margin:auto;
    margin-bottom:20px;
    text-decoration:none;
    position:relative;
    overflow:hidden;
  }
  .create-account-redirect > .wrapper-buttons > a:first-of-type{
  
  }
  .create-account-redirect > .wrapper-buttons > a:last-of-type{
    background: #fff;
    color: #000;
    border:1px solid #000;
  }
  .create-account-redirect > .wrapper-buttons > a:hover > span{
      animation-name: scroll-in-big;
  }
  .create-account-redirect > .wrapper-buttons > a > span{
    display: flex;
    align-items: center;
    animation-duration: .25s;
    animation-timing-function: ease-in-out;
    position: absolute;
  }

  @keyframes scroll-in-big {
    0% { top: 20px; }
    49% { top: -15px; }
    50% { top: 35px; }
    100% { top: 20px; }
  }

  @media screen and (max-width:1200px){
     .create-account-redirect > .wrapper-buttons{
      margin-top: 0;
      position: absolute;
      right: 0;
      left: 0;
     }
  }

  @media screen and (max-width:989px){
    .create-account-redirect{
      flex-direction:column;
      justify-content: center;
    }
    .create-account-redirect > .wrapper-buttons{
      position:initial;
    }
    .create-account-redirect > .top--image > img{
      width:50%;
    }
  }
   @media screen and (max-width: 759px){
    .create-account-redirect > .top--image{
      padding: 10px 20px;
    }
    .create-account-redirect > .top--image > img{
      width:100%;
    }
   }

{% endstyle %}


{% schema %}
  {
    "name": "Create an account",
    "settings": []
  }
{% endschema %}