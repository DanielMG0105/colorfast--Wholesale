    font: inherit;
    font-size: 17px;
    text-align: center;
  }

  .dye-preview__add {
    height: 56px;
    border: 1px solid var(--dp-text);
    background: var(--dp-text);
    color: var(--dp-bg);
    font: inherit;
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .dye-preview__add[disabled] {
    background: transparent;
    color: var(--dp-text);
    opacity: 0.6;
    cursor: not-allowed;
  }

  .dye-preview__message {
    margin: 0;
    font-size: 14px;
  }
{% endstylesheet %}

