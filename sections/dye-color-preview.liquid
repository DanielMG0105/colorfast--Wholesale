{%- liquid
  assign font = section.settings.font
  assign garments = section.blocks | where: 'type', 'garment'
  assign color_lines = section.settings.colors | newline_to_br | split: '<br />'
-%}

<style>
  {{ font | font_face: font_display: 'swap' }}
</style>

<dye-color-preview
  id="custom-dye"
  class="dye-preview{% if section.settings.show_vignette %} dye-preview--vignette{% endif %}"
  data-footer-bg="ignore"
  style="
    --dp-bg: {{ section.settings.background_color }};
    --dp-text: {{ section.settings.text_color }};
    --dp-vignette: {{ section.settings.vignette_color }};
    --dp-font-family: {{ font.family }}, {{ font.fallback_families }};
    --dp-font-weight: {{ font.weight }};
    --dp-image-width: {{ section.settings.image_width }}px;
    --dp-wheel-size: {{ section.settings.wheel_size }}px;
    --dp-pt: {{ section.settings.padding_top }}px;
    --dp-pb: {{ section.settings.padding_bottom }}px;
  "
>
  {%- comment -%} Color presets for the wheel arrows, from "Name: #hex" lines {%- endcomment -%}
  <script type="application/json" data-presets>
    [
      {%- assign first_preset = true -%}
      {%- for line in color_lines -%}
        {%- assign parts = line | strip | split: ':' -%}
        {%- if parts.size > 1 -%}
          {%- unless first_preset %},{% endunless -%}
          {"name": {{ parts[0] | strip | json }}, "hex": {{ parts[1] | strip | json }}}
          {%- assign first_preset = false -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>

  {%- paginate collections.all.products by 250 -%}
    <script type="application/json" data-dyeable-products>
      [
        {%- assign first_dyeable_product = true -%}
        {%- for candidate in collections.all.products -%}
          {%- if candidate.metafields.custom.custom_dye.value == true -%}
            {%- unless first_dyeable_product -%},{%- endunless -%}
            {%- assign candidate_image = candidate.metafields.custom.dye_image.value | default: candidate.featured_image -%}
            {"handle":{{ candidate.handle | json }},"title":{{ candidate.title | json }},"image":{% if candidate_image != blank %}{{ candidate_image | image_url: width: 320 | json }}{% else %}null{% endif %}}
            {%- assign first_dyeable_product = false -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    </script>
  {%- endpaginate -%}

  <div class="dye-preview__stage">
    {%- for block in garments -%}
      {%- liquid
        assign garment_image = block.settings.image
        if garment_image == blank and block.settings.product != blank
          assign garment_image = block.settings.product.featured_image
        endif
        assign garment_label = block.settings.label | default: block.settings.product.title
        assign garment_url = block.settings.product.url
      -%}
      <div
        class="dye-preview__garment"
        data-garment
        {% if block.settings.product != blank %}
          data-product-handle="{{ block.settings.product.handle }}"
        {% endif %}
        {% unless forloop.first %}
          hidden
        {% endunless %}
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.product != blank -%}
          <script type="application/json" data-product>
            {% render 'dye-product-data', product: block.settings.product %}
          </script>
        {%- endif -%}
        {%- if garment_label != blank -%}
          <div class="dye-preview__product-choice">
            <p class="dye-preview__product-hint">Select a product</p>
            <button type="button" class="dye-preview__pill dye-preview__product-trigger" data-open-product-picker aria-haspopup="dialog">
              {{ garment_label | escape }}
            </button>
          </div>
        {%- endif -%}

        <div class="dye-preview__row">
          <button type="button" class="dye-preview__arrow" data-garment-step="-1" aria-label="Previous garment">
            {%- render 'dye-preview-arrow', direction: 'left' -%}
          </button>

          <div class="dye-preview__image">
            {%- if garment_image != blank -%}
              {%- assign mask_url = garment_image | image_url: width: 1200 -%}
              {%- assign garment_alt = garment_label | default: garment_image.alt | escape -%}
              {{
                garment_image
                | image_url: width: 1200
                | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 430px, 80vw', loading: 'lazy', alt: garment_alt
              }}
              {%- liquid
                assign tint_style = "--dp-mask: url('" | append: mask_url | append: "');"
                assign tint_class = 'dye-preview__tint'
                if block.settings.protect_image != blank
                  assign protect_url = block.settings.protect_image | image_url: width: 1200
                  assign tint_style = tint_style | append: " --dp-protect: url('" | append: protect_url | append: "');"
                  assign tint_class = tint_class | append: ' dye-preview__tint--protected'
                endif
              -%}
              <span class="{{ tint_class }}" style="{{ tint_style }}" aria-hidden="true"></span>
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'dye-preview__placeholder' }}
            {%- endif -%}
          </div>

          <button type="button" class="dye-preview__arrow" data-garment-step="1" aria-label="Next garment">
            {%- render 'dye-preview-arrow', direction: 'right' -%}
          </button>
        </div>
      </div>
    {%- else -%}
      <div class="dye-preview__garment" data-garment>
        <p class="dye-preview__pill">Add a garment block</p>
        <div class="dye-preview__row">
          <div class="dye-preview__image">
            {{ 'product-apparel-1' | placeholder_svg_tag: 'dye-preview__placeholder' }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} Filled by the script for a product opened from its custom dye swatch (?product=handle) {%- endcomment -%}
  <template data-garment-template>
    <div class="dye-preview__garment" data-garment>
      <div class="dye-preview__product-choice">
        <p class="dye-preview__product-hint">Select a product</p>
        <button type="button" class="dye-preview__pill dye-preview__product-trigger" data-garment-label data-open-product-picker aria-haspopup="dialog"></button>
      </div>
      <div class="dye-preview__row">
        <button type="button" class="dye-preview__arrow" data-garment-step="-1" aria-label="Previous garment">
          {%- render 'dye-preview-arrow', direction: 'left' -%}
        </button>
        <div class="dye-preview__image">
          <img data-garment-image alt="" width="1200" height="1500">
          <span class="dye-preview__tint" data-garment-tint aria-hidden="true"></span>
        </div>
        <button type="button" class="dye-preview__arrow" data-garment-step="1" aria-label="Next garment">
          {%- render 'dye-preview-arrow', direction: 'right' -%}
        </button>
      </div>
    </div>
  </template>

  <dialog class="dye-preview__picker" data-product-picker aria-labelledby="dye-preview-picker-title">
    <div class="dye-preview__picker-header">
      <div>
        <p class="dye-preview__picker-eyebrow">CUSTOM DYE PROGRAM</p>
        <h2 id="dye-preview-picker-title">Choose a garment</h2>
        <p class="dye-preview__picker-description">Select a garment to preview your custom color.</p>
      </div>
      <button type="button" class="dye-preview__picker-close" data-close-product-picker aria-label="Close product selector">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="dye-preview__picker-tools">
      <label class="dye-preview__picker-search">
        <span class="visually-hidden">Search garments</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.8" cy="8.8" r="5.8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m13.2 13.2 4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <input type="search" placeholder="Search garments" autocomplete="off" data-product-picker-search>
      </label>
      <span class="dye-preview__picker-count" data-product-picker-count></span>
    </div>
    <div class="dye-preview__picker-list" data-product-picker-list></div>
    <p class="dye-preview__picker-empty" data-product-picker-empty hidden>No garments match your search.</p>
  </dialog>

  <div class="dye-preview__selector">
    {%- if section.settings.selector_label != blank -%}
      <p class="dye-preview__pill">{{ section.settings.selector_label | escape }}</p>
    {%- endif -%}

    <div class="dye-preview__row">
      <button type="button" class="dye-preview__arrow" data-color-step="-1" aria-label="Previous color">
        {%- render 'dye-preview-arrow', direction: 'left' -%}
      </button>

      <div
        class="dye-preview__wheel"
        data-wheel
        role="slider"
        tabindex="0"
        aria-label="Color"
        aria-valuemin="0"
        aria-valuemax="359"
        aria-valuenow="0"
        aria-valuetext="Original"
      >
        <span class="dye-preview__handle" data-handle aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M14.5 4.5 19.5 9.5" stroke="#000" stroke-width="3.2" stroke-linecap="round"/>
            <path d="M16.2 2.8a2.4 2.4 0 0 1 3.4 0l1.6 1.6a2.4 2.4 0 0 1 0 3.4l-2.1 2.1-5-5z" fill="#000"/>
            <path d="M13.3 7.2 4.6 15.9 3.5 20.5l4.6-1.1 8.7-8.7" fill="#fff" stroke="#000" stroke-width="1.4" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>

      <button type="button" class="dye-preview__arrow" data-color-step="1" aria-label="Next color">
        {%- render 'dye-preview-arrow', direction: 'right' -%}
      </button>
    </div>

    {%- if section.settings.show_hex_input -%}
      <label class="dye-preview__hex">
        <span class="visually-hidden">HEX color</span>
        <input type="text" inputmode="text" maxlength="7" placeholder="#RRGGBB" spellcheck="false" data-hex-input>
      </label>
    {%- endif -%}

    {%- if section.settings.show_color_name -%}
      <p class="dye-preview__color-name" data-color-name aria-live="polite">&nbsp;</p>
    {%- endif -%}

    {%- if section.settings.show_reset -%}
      <button type="button" class="dye-preview__reset" data-reset>{{ section.settings.reset_label | escape }}</button>
    {%- endif -%}
  </div>

  {%- if section.settings.enable_add_to_cart -%}
    {%- comment -%} Shown for garments whose product has custom.custom_dye = true {%- endcomment -%}
    <div class="dye-preview__purchase" data-purchase hidden>
      <p class="dye-preview__price" data-purchase-price></p>
      <div class="dye-preview__options" data-purchase-options></div>
      <div class="dye-preview__buy">
        <label class="dye-preview__quantity">
          <span class="visually-hidden">Quantity</span>
          <input type="number" min="1" value="1" inputmode="numeric" data-purchase-quantity>
        </label>
        <button type="button" class="dye-preview__add" data-purchase-add disabled>
          {{- section.settings.choose_color_label | default: 'Choose a color' | escape -}}
        </button>
      </div>
      <p class="dye-preview__message" role="status" data-purchase-message hidden></p>
    </div>
  {%- endif -%}
</dye-color-preview>

<script type="module">
  import { CartLinesUpdateEvent, CartErrorEvent } from '@shopify/events';

  if (!customElements.get('dye-color-preview')) {
    customElements.define(
      'dye-color-preview',
      class DyeColorPreview extends HTMLElement {
        connectedCallback() {
          this.presets = JSON.parse(this.querySelector('[data-presets]')?.textContent || '[]');
          this.presetIndex = -1;
          this.garments = [...this.querySelectorAll('[data-garment]')];
          this.garmentIndex = 0;
          this.wheel = this.querySelector('[data-wheel]');
          this.handle = this.querySelector('[data-handle]');
          this.colorName = this.querySelector('[data-color-name]');

          this.querySelectorAll('[data-garment-step]').forEach((button) =>
            button.addEventListener('click', () => this.stepGarment(Number(button.dataset.garmentStep)))
          );
          this.querySelectorAll('[data-color-step]').forEach((button) =>
            button.addEventListener('click', () => this.stepPreset(Number(button.dataset.colorStep)))
          );
          this.querySelector('[data-reset]')?.addEventListener('click', () => this.reset());
          this.hexInput = this.querySelector('[data-hex-input]');
          this.hexInput?.addEventListener('change', () => {
            let value = this.hexInput.value.trim();
            if (!value.startsWith('#')) value = `#${value}`;
            if (/^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(value)) this.setHex(value.toUpperCase(), value.toUpperCase());
          });

          this.wheel.addEventListener('pointerdown', (event) => {
            this.wheel.setPointerCapture(event.pointerId);
            this.pickFromPointer(event);
            const move = (e) => this.pickFromPointer(e);
            const up = () => {
              this.wheel.removeEventListener('pointermove', move);
              this.wheel.removeEventListener('pointerup', up);
            };
            this.wheel.addEventListener('pointermove', move);
            this.wheel.addEventListener('pointerup', up);
          });

          this.wheel.addEventListener('keydown', (event) => {
            const keys = { ArrowRight: [10, 0], ArrowLeft: [-10, 0], ArrowUp: [0, 0.1], ArrowDown: [0, -0.1] };
            if (!keys[event.key]) return;
            event.preventDefault();
            const [dh, ds] = keys[event.key];
            const state = this.state ?? { hue: 0, sat: 1 };
            this.setColor((state.hue + dh + 360) % 360, Math.min(1, Math.max(0, state.sat + ds)));
          });

          this.dye = null;
          this.selection = null;
          this.purchase = this.querySelector('[data-purchase]');
          this.addButton = this.querySelector('[data-purchase-add]');
          this.quantity = this.querySelector('[data-purchase-quantity]');
          this.message = this.querySelector('[data-purchase-message]');
          this.dyeableProducts = JSON.parse(this.querySelector('[data-dyeable-products]')?.textContent || '[]');
          this.productPicker = this.querySelector('[data-product-picker]');
          this.productPickerList = this.querySelector('[data-product-picker-list]');
          this.productPickerSearch = this.querySelector('[data-product-picker-search]');
          this.productPickerCount = this.querySelector('[data-product-picker-count]');
          this.productPickerEmpty = this.querySelector('[data-product-picker-empty]');
          this.renderProductPicker();
          this.productPickerSearch?.addEventListener('input', () => this.filterProductPicker());
          this.addEventListener('click', (event) => {
            const trigger = event.target.closest('[data-open-product-picker]');
            if (trigger) {
              event.preventDefault();
              if (this.productPickerSearch) this.productPickerSearch.value = '';
              this.filterProductPicker();
              this.productPicker?.showModal();
              return;
            }
            const productButton = event.target.closest('[data-select-dye-product]');
            if (productButton) this.selectDyeProduct(productButton.dataset.productHandle);
          });
          this.querySelector('[data-close-product-picker]')?.addEventListener('click', () => this.productPicker?.close());
          this.productPicker?.addEventListener('click', (event) => {
            if (event.target === this.productPicker) this.productPicker.close();
          });
          this.garments.forEach((garment) => {
            const json = garment.querySelector('[data-product]')?.textContent;
            if (json) garment.product = JSON.parse(json);
          });
          this.addButton?.addEventListener('click', () => this.addToCart());

          this.toggleArrows();
          this.placeHandle(0.5, 0.5);
          this.updatePurchase();
          this.loadRequestedProduct();
        }

        toggleArrows() {
          this.querySelectorAll('[data-garment-step]').forEach(
            (button) => (button.style.visibility = this.garments.length < 2 ? 'hidden' : '')
          );
          if (this.presets.length < 2) {
            this.querySelectorAll('[data-color-step]').forEach((button) => (button.style.visibility = 'hidden'));
          }
        }

        stepGarment(step) {
          if (this.garments.length < 2) return;
          this.showGarment((this.garmentIndex + step + this.garments.length) % this.garments.length);
        }

        renderProductPicker() {
          if (!this.productPickerList) return;
          if (!this.dyeableProducts.length) {
            this.productPickerList.textContent = 'No custom dye products are available.';
            if (this.productPickerCount) this.productPickerCount.textContent = '0 GARMENTS';
            if (this.productPickerEmpty) this.productPickerEmpty.hidden = true;
            return;
          }

          const cards = this.dyeableProducts.map((product) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'dye-preview__picker-product';
            button.dataset.selectDyeProduct = '';
            button.dataset.productHandle = product.handle;
            button.dataset.productTitle = product.title.toLowerCase();

            const imageFrame = document.createElement('span');
            imageFrame.className = 'dye-preview__picker-image';
            if (product.image) {
              const image = document.createElement('img');
              image.src = product.image;
              image.alt = '';
              image.loading = 'lazy';
              imageFrame.append(image);
            } else {
              imageFrame.classList.add('is-placeholder');
            }
            button.append(imageFrame);

            const title = document.createElement('span');
            title.className = 'dye-preview__picker-title';
            title.textContent = product.title;
            button.append(title);
            const arrow = document.createElement('span');
            arrow.className = 'dye-preview__picker-arrow';
            arrow.setAttribute('aria-hidden', 'true');
            arrow.textContent = '→';
            button.append(arrow);
            return button;
          });
          this.productPickerList.replaceChildren(...cards);
          if (this.productPickerCount) {
            this.productPickerCount.textContent = `${cards.length} ${cards.length === 1 ? 'GARMENT' : 'GARMENTS'}`;
          }
        }

        filterProductPicker() {
          const query = this.productPickerSearch?.value.trim().toLowerCase() ?? '';
          let visibleCount = 0;
          this.productPickerList?.querySelectorAll('[data-select-dye-product]').forEach((button) => {
            const matches = button.dataset.productTitle.includes(query);
            button.hidden = !matches;
            if (matches) visibleCount += 1;
          });
          if (this.productPickerCount) {
            this.productPickerCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'GARMENT' : 'GARMENTS'}`;
          }
          if (this.productPickerEmpty) this.productPickerEmpty.hidden = visibleCount > 0;
        }

        async selectDyeProduct(handle) {
          if (!this.dyeableProducts.some((item) => item.handle === handle)) return;
          this.productPicker?.close();
          try {
            const root = window.Shopify?.routes?.root ?? '/';
            const response = await fetch(`${root}products/${encodeURIComponent(handle)}?view=dye-data`);
            if (!response.ok) throw new Error('Could not load the selected product.');
            const product = await response.json();
            if (!product.dyeable) throw new Error('This product is not available for custom dye.');
            this.setProductInView(product);
          } catch (error) {
            this.message.textContent = error.message;
            this.message.hidden = false;
          }
        }

        setProductInView(product) {
          const existing = this.garments.findIndex((garment) => garment.dataset.productHandle === product.handle);
          if (existing > -1) {
            this.showGarment(existing);
            return;
          }

          const garment = this.buildGarment(product);
          this.garments.forEach((item) => (item.hidden = true));
          this.querySelector('.dye-preview__stage').prepend(garment);
          this.garments.unshift(garment);
          this.garmentIndex = 0;
          this.selection = null;
          this.toggleArrows();
          this.updatePurchase();
        }

        showGarment(index) {
          this.garments[this.garmentIndex].hidden = true;
          this.garmentIndex = index;
          this.garments[this.garmentIndex].hidden = false;
          this.selection = null;
          this.updatePurchase();
        }

        // Opened from a product's custom dye swatch (?product=handle): show that product first,
        // fetching it through the product.dye-data template when no garment block already has it
        async loadRequestedProduct() {
          const handle = new URLSearchParams(window.location.search).get('product');
          if (!handle) return;

          const existing = this.garments.findIndex((garment) => garment.dataset.productHandle === handle);
          if (existing > -1) {
            this.showGarment(existing);
            return;
          }

          try {
            const root = window.Shopify?.routes?.root ?? '/';
            const response = await fetch(`${root}products/${encodeURIComponent(handle)}?view=dye-data`);
            if (!response.ok) return;
            const product = await response.json();
            if (!product.image) return;

            this.setProductInView(product);
          } catch (error) {
            console.error('Custom dye: could not load product', error);
          }
        }

        buildGarment(product) {
          const fragment = this.querySelector('[data-garment-template]').content.cloneNode(true);
          const garment = fragment.querySelector('[data-garment]');
          garment.dataset.productHandle = product.handle;
          garment.product = product;

          const label = garment.querySelector('[data-garment-label]');
          label.textContent = product.title;

          const image = garment.querySelector('[data-garment-image]');
          image.src = product.image;
          image.alt = product.title;

          const tint = garment.querySelector('[data-garment-tint]');
          tint.style.setProperty('--dp-mask', `url('${product.image}')`);
          if (product.protect) {
            tint.style.setProperty('--dp-protect', `url('${product.protect}')`);
            tint.classList.add('dye-preview__tint--protected');
          }

          garment.querySelectorAll('[data-garment-step]').forEach((button) =>
            button.addEventListener('click', () => this.stepGarment(Number(button.dataset.garmentStep)))
          );
          return garment;
        }

        get product() {
          return this.garments[this.garmentIndex]?.product;
        }

        // The dyed garment is always the undyed base color (PFD / White / Natural, else the first color)
        baseColor() {
          const colorIndex = this.product.colorPosition - 1;
          if (colorIndex < 0) return null;
          const values = this.product.options[colorIndex].values;
          return values.find((value) => /pfd|white|natural/i.test(value)) ?? values[0];
        }

        findVariant(options) {
          const colorIndex = this.product.colorPosition - 1;
          const base = this.baseColor();
          return this.product.variants.find((variant) =>
            variant.options.every((value, i) => (i === colorIndex ? value === base : value === options[i]))
          );
        }

        formatOptionValue(optionName, value) {
          const normalized = String(value ?? '').trim();
          if (!/size|talla/i.test(optionName)) return normalized;

          const sizeLabels = { xxs: '2XS', xs: 'XS', sm: 'S', md: 'M', lg: 'G', xl: 'XL' };
          return sizeLabels[normalized.toLowerCase()] ?? normalized.toUpperCase();
        }

        // Buttons for size and any other non-color option of the current garment's product
        updatePurchase() {
          if (!this.purchase) return;
          const product = this.product;
          this.purchase.hidden = !product?.dyeable;
          this.message.hidden = true;
          if (!product?.dyeable) return;

          const colorIndex = product.colorPosition - 1;
          if (!this.selection) {
            const base = this.baseColor();
            const first =
              product.variants.find((variant) => variant.available && (colorIndex < 0 || variant.options[colorIndex] === base)) ??
              product.variants[0];
            this.selection = [...first.options];
          }

          const fieldsets = product.options
            .map((option, index) => {
              if (index === colorIndex || option.values.length < 2) return null;
              const fieldset = document.createElement('fieldset');
              fieldset.className = 'dye-preview__option';
              const legend = document.createElement('legend');
              legend.textContent = option.name;
              fieldset.append(legend);

              option.values.forEach((value) => {
                const candidate = [...this.selection];
                candidate[index] = value;
                const variant = this.findVariant(candidate);
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'dye-preview__value';
                button.textContent = this.formatOptionValue(option.name, value);
                button.setAttribute('aria-pressed', String(this.selection[index] === value));
                button.classList.toggle('is-unavailable', !variant?.available);
                button.addEventListener('click', () => {
                  this.selection[index] = value;
                  this.updatePurchase();
                });
                fieldset.append(button);
              });
              return fieldset;
            })
            .filter(Boolean);
          this.purchase.querySelector('[data-purchase-options]').replaceChildren(...fieldsets);

          const variant = this.findVariant(this.selection);
          this.purchase.querySelector('[data-purchase-price]').textContent = variant?.price ?? '';
          this.updateAddButton();
        }

        updateAddButton() {
          if (!this.addButton || !this.product?.dyeable || !this.selection) return;
          const variant = this.findVariant(this.selection);
          if (!variant || !variant.available) {
            this.addButton.disabled = true;
            this.addButton.textContent = {{ section.settings.sold_out_label | default: 'Sold out' | json }};
          } else if (!this.dye) {
            this.addButton.disabled = true;
            this.addButton.textContent = {{ section.settings.choose_color_label | default: 'Choose a color' | json }};
          } else {
            this.addButton.disabled = false;
            this.addButton.textContent = {{ section.settings.add_label | default: 'Add to cart' | json }};
          }
        }

        // Adds the base variant with the chosen color as line item properties
        async addToCart() {
          if (!this.addButton || !this.purchase) return;
          const variant = this.findVariant(this.selection ?? []);
          if (!variant || !this.dye) return;

          const quantity = Math.max(1, parseInt(this.quantity.value, 10) || 1);
          const properties = { 'Dye color': this.dye.name };
          if (this.dye.name !== this.dye.hex) properties['Dye hex'] = this.dye.hex;
          const items = [{ id: variant.id, quantity, properties }];

          const sections = [...document.querySelectorAll('cart-items-component')]
            .map((element) => element.dataset.sectionId)
            .filter(Boolean);
          const deferred = CartLinesUpdateEvent.createPromise();
          this.dispatchEvent(
            new CartLinesUpdateEvent({
              action: 'add',
              context: 'product',
              lines: [{ merchandiseId: String(variant.id), quantity }],
              promise: deferred.promise,
            })
          );

          this.addButton.disabled = true;
          this.message.hidden = true;

          try {
            const root = window.Shopify?.routes?.root ?? '/';
            const response = await fetch(`${root}cart/add.js`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ items, sections: sections.join(',') }),
            }).then((res) => res.json());
            if (response.status) throw new Error(response.description || response.message || 'Add to cart failed');

            const cart = await fetch(`${root}cart.js`).then((res) => res.json());
            deferred.resolve({
              cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart),
              detail: {
                items: cart.items,
                source: 'dye-color-preview',
                sourceId: this.closest('.shopify-section')?.id,
                itemCount: quantity,
                sections: response.sections,
                didError: false,
              },
            });

            this.addButton.textContent = {{ section.settings.added_label | default: 'Added' | json }};
            setTimeout(() => this.updateAddButton(), 2000);
          } catch (error) {
            deferred.reject(error);
            this.dispatchEvent(new CartErrorEvent({ error: error.message, code: 'INVALID' }));
            this.message.textContent = error.message;
            this.message.hidden = false;
            this.updateAddButton();
          }
        }

        // Wheel geometry: angle from the top, clockwise -> hue; distance from center -> saturation (white center)
        pickFromPointer(event) {
          const rect = this.wheel.getBoundingClientRect();
          const x = event.clientX - rect.left - rect.width / 2;
          const y = event.clientY - rect.top - rect.height / 2;
          const radius = rect.width / 2;
          const sat = Math.min(1, Math.hypot(x, y) / radius);
          const angle = (Math.atan2(x, -y) * 180) / Math.PI;
          const hue = (angle + 270 + 360) % 360;
          this.presetIndex = -1;
          this.setColor(hue, sat);
        }

        setColor(hue, sat, name) {
          this.state = { hue, sat };
          const lightness = 100 - 50 * sat;
          const color = `hsl(${Math.round(hue)} 100% ${lightness}%)`;
          this.applyColor(color, name ?? this.hslToHex(hue, 100, lightness).toUpperCase());
          const angle = ((hue - 270 + 360) % 360) * (Math.PI / 180);
          this.placeHandle(0.5 + (Math.sin(angle) * sat) / 2, 0.5 - (Math.cos(angle) * sat) / 2);
          this.wheel.setAttribute('aria-valuenow', String(Math.round(hue)));
        }

        applyColor(color, label) {
          const hex = color.startsWith('#') ? color.toUpperCase() : this.currentHex();
          this.dye = { name: label, hex };
          this.updateAddButton();
          this.style.setProperty('--dp-color', color);
          this.classList.add('is-tinted');
          if (this.colorName) this.colorName.textContent = label;
          if (this.hexInput && document.activeElement !== this.hexInput) {
            this.hexInput.value = hex;
          }
          this.wheel.setAttribute('aria-valuetext', label);
        }

        stepPreset(step) {
          if (!this.presets.length) return;
          this.presetIndex = (this.presetIndex + step + this.presets.length) % this.presets.length;
          const preset = this.presets[this.presetIndex];
          this.setHex(preset.hex, preset.name);
        }

        // Apply an exact color and place the dropper at the closest point of the wheel
        setHex(hex, name) {
          const { h, s, l } = this.hexToHsl(hex);
          this.state = { hue: h, sat: Math.min(1, Math.max(0, (100 - l) / 50)) };
          this.applyColor(hex, name);
          const sat = this.state.sat * (s / 100);
          const angle = ((h - 270 + 360) % 360) * (Math.PI / 180);
          this.placeHandle(0.5 + (Math.sin(angle) * sat) / 2, 0.5 - (Math.cos(angle) * sat) / 2);
          this.wheel.setAttribute('aria-valuenow', String(Math.round(h)));
        }

        reset() {
          this.style.removeProperty('--dp-color');
          this.classList.remove('is-tinted');
          this.presetIndex = -1;
          this.state = null;
          this.dye = null;
          this.updateAddButton();
          this.placeHandle(0.5, 0.5);
          if (this.colorName) this.colorName.innerHTML = '&nbsp;';
          if (this.hexInput) this.hexInput.value = '';
          this.wheel.setAttribute('aria-valuetext', 'Original');
        }

        currentHex() {
          if (!this.state) return '';
          return this.hslToHex(this.state.hue, 100, 100 - 50 * this.state.sat).toUpperCase();
        }

        placeHandle(x, y) {
          this.handle.style.left = `${x * 100}%`;
          this.handle.style.top = `${y * 100}%`;
        }

        hexToHsl(hex) {
          const value = hex.replace('#', '');
          const full = value.length === 3 ? [...value].map((c) => c + c).join('') : value;
          const r = parseInt(full.slice(0, 2), 16) / 255;
          const g = parseInt(full.slice(2, 4), 16) / 255;
          const b = parseInt(full.slice(4, 6), 16) / 255;
          const max = Math.max(r, g, b);
          const min = Math.min(r, g, b);
          const l = (max + min) / 2;
          let h = 0;
          let s = 0;
          if (max !== min) {
            const d = max - min;
            s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
            if (max === r) h = (g - b) / d + (g < b ? 6 : 0);
            else if (max === g) h = (b - r) / d + 2;
            else h = (r - g) / d + 4;
            h *= 60;
          }
          return { h, s: s * 100, l: l * 100 };
        }

        hslToHex(h, s, l) {
          const a = (s / 100) * Math.min(l / 100, 1 - l / 100);
          const f = (n) => {
            const k = (n + h / 30) % 12;
            const c = l / 100 - a * Math.max(-1, Math.min(k - 3, 9 - k, 1));
            return Math.round(c * 255)
              .toString(16)
              .padStart(2, '0');
          };
          return `#${f(0)}${f(8)}${f(4)}`;
        }
      }
    );
  }
</script>

